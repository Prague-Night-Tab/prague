<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Prague drink prices, happy hours and nightlife spending in one dashboard. Beer by neighbourhood, cocktails, club fees, a weekly happy hour table and maps. Available in ten languages.">
<meta name="theme-color" content="#0d1015" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#f2f3f6" media="(prefers-color-scheme: light)">
<meta property="og:type" content="website">
<meta property="og:title" content="Prague Night Tab">
<meta property="og:description" content="Prague drink prices, happy hours and nightlife spending in one dashboard. Beer by neighbourhood, cocktails, club fees, a weekly happy hour table and maps. Available in ten languages.">
<meta name="twitter:card" content="summary">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230d1015'/%3E%3Cpath d='M9 8v16M13 8v16M17 8v16M21 8v16M6 21L24 11' stroke='%23eaa63a' stroke-width='2.4' stroke-linecap='round'/%3E%3C/svg%3E">
<title>Prague Night Tab App</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<style>:root{--bg:#0d1015;--surface:#151a22;--surface-2:#1b212b;--line:#262d39;--line-strong:#394253;--text:#eef0f4;--muted:#9aa3b2;--dim:#6b7585;--amber:#eaa63a;--amber-ink:#1a1204;--food:#6ea8e0;--cover:#e07a90;--good:#5ccf9b;--bad:#f0806b;--coaster:#e9dcc0;--coaster-ink:#2a2113;--f-display:'Bricolage Grotesque','Arial Narrow',system-ui,sans-serif;--f-body:'Instrument Sans',system-ui,-apple-system,'Segoe UI',sans-serif;--f-mono:'JetBrains Mono',ui-monospace,Menlo,monospace;color-scheme:dark;}@media (prefers-color-scheme: light){:root:not([data-theme="dark"]){--bg:#f2f3f6;--surface:#ffffff;--surface-2:#f6f7f9;--line:#dfe3ea;--line-strong:#c4cad6;--text:#14181f;--muted:#566074;--dim:#7b8496;--amber:#b86f00;--amber-ink:#ffffff;--food:#2c6cb0;--cover:#b44461;--good:#17805a;--bad:#c4432e;color-scheme:light;}}:root[data-theme="light"]{--bg:#f2f3f6;--surface:#ffffff;--surface-2:#f6f7f9;--line:#dfe3ea;--line-strong:#c4cad6;--text:#14181f;--muted:#566074;--dim:#7b8496;--amber:#b86f00;--amber-ink:#ffffff;--food:#2c6cb0;--cover:#b44461;--good:#17805a;--bad:#c4432e;color-scheme:light;}*{box-sizing:border-box}html{scroll-behavior:smooth}body{background:var(--bg);color:var(--text);font-family:var(--f-body);font-size:15px;line-height:1.5;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0;overflow-x:hidden}body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--bg)}h1,h2,h3{font-family:var(--f-display);margin:0;text-wrap:balance;letter-spacing:-.01em}p{margin:0}a{color:var(--amber)}:focus-visible{outline:2px solid var(--amber);outline-offset:2px;border-radius:4px}.num,table,.rr-v,.br-h b,.kv b{font-variant-numeric:tabular-nums}.top{display:flex;flex-direction:column;gap:14px}.tools{display:flex;gap:8px}.langsel{flex:1;min-width:0;height:36px;padding:0 10px;border-radius:8px;border:1px solid var(--line-strong);background:var(--surface);color:var(--text);font:inherit;font-size:14px;cursor:pointer}.themebtn{flex:none;width:36px;height:36px;display:grid;place-items:center;border-radius:8px;border:1px solid var(--line-strong);background:var(--surface);color:var(--text);cursor:pointer;padding:0}.themebtn svg{width:18px;height:18px}.langsel:hover,.themebtn:hover{border-color:var(--amber)}.langsel:focus-visible,.themebtn:focus-visible{outline:2px solid var(--amber);outline-offset:2px}.ver{margin:10px 0 0;font-family:var(--f-mono);font-size:11px;letter-spacing:.06em;color:var(--dim)}:lang(ja) h1,:lang(zh) h1{letter-spacing:0;font-size:clamp(30px,4.2vw,52px)}.modes{display:flex;gap:4px;padding:3px;border:1px solid var(--line-strong);border-radius:10px;background:var(--surface);margin:0 0 14px}.modes button{flex:1;height:32px;border:0;border-radius:7px;background:transparent;color:var(--dim);font:inherit;font-size:14px;font-weight:600;cursor:pointer}.modes button[aria-pressed="true"]{background:var(--amber);color:#1a1206}.modes button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}html[data-mode="lite"] .sec:not(#s-go):not(#s-weekend):not(#s-happy):not(#s-food){display:none}.instbtn{display:none}html[data-mode="lite"] .instbtn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:52px;margin:0 0 12px;border:1px solid var(--amber);border-radius:16px;background:transparent;color:var(--amber);font:inherit;font-size:17px;font-weight:700;cursor:pointer}html[data-mode="lite"] .instbtn[hidden]{display:none}.insthelp{margin:0 0 12px;padding:12px 14px;border-radius:12px;background:var(--surface);border:1px solid var(--line-strong);font-size:15px}.insthelp[hidden]{display:none}html[data-mode="lite"] .readout{display:none}html[data-mode="lite"] .main{font-size:17px}html[data-mode="lite"] .main p,html[data-mode="lite"] .main li{line-height:1.6}html[data-mode="lite"] .sec-head p{font-size:17px}@media (max-width:900px){.modes{margin:10px 0 0}}.amap{width:100%;height:auto;display:block;max-height:520px}.hh-now{margin:0 0 12px;font-size:15px}.wk{width:100%;border-collapse:collapse;font-size:13px}.wk th,.wk td{padding:7px 8px;text-align:center;white-space:nowrap;border-bottom:1px solid var(--line);color:var(--dim)}.wk th:first-child,.wk td:first-child{text-align:left;color:var(--text);position:sticky;left:0;background:var(--surface);white-space:normal;min-width:130px}.wk th.today,.wk td.today{background:color-mix(in srgb,var(--amber) 13%,var(--surface));color:var(--text)}.wk td.live{font-weight:700;color:var(--amber)}.maps{display:inline-flex;flex-wrap:wrap;gap:4px 10px;font-size:13px}.maps.big{display:flex;margin:12px 0 0;font-size:14px;align-items:baseline}.maps small{flex-basis:100%;color:var(--dim);font-size:12px}.maps b{color:var(--text);font-weight:600}.vn{color:inherit;text-decoration:none;border-bottom:1px dotted var(--dim)}.vn:hover{color:var(--amber)}.hh-note.warn{color:var(--bad);font-weight:600}#s-go{display:none}html[data-mode="lite"] #s-go{display:block}html[data-mode="lite"] #s-go .sec-head h2{font-size:clamp(34px,5vw,56px);line-height:1.02}.gotabs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:4px 0 18px;max-width:560px}.gotabs button{height:56px;border-radius:16px;border:1px solid var(--line-strong);background:var(--surface);color:var(--text);font:inherit;font-size:18px;font-weight:700;cursor:pointer}.gotabs button[aria-pressed="true"]{background:var(--amber);border-color:var(--amber);color:#1a1206}.gotabs button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}.go-head{margin:0 0 12px;font-size:15px;color:var(--dim)}.golist{display:grid;gap:10px;max-width:760px}.gocard{display:grid;grid-template-columns:1fr auto;gap:6px 14px;align-items:center;padding:14px 16px;border:1px solid var(--line-strong);border-radius:16px;background:var(--surface)}.gc-main b{display:block;font-size:18px;line-height:1.2}.gc-main small{display:block;margin-top:3px;color:var(--dim);font-size:13.5px;line-height:1.4}.gc-pill{grid-column:1;justify-self:start;padding:3px 10px;border-radius:999px;font-size:12.5px;font-weight:700;background:color-mix(in srgb,var(--amber) 18%,transparent);color:var(--amber)}.gc-pill.live{background:color-mix(in srgb,var(--good) 20%,transparent);color:var(--good)}.gc-go{grid-column:2;grid-row:1 / span 2;display:grid;place-items:center;min-width:64px;height:48px;padding:0 16px;border-radius:12px;background:var(--amber);color:#1a1206;font-weight:800;text-decoration:none}.gc-go:focus-visible{outline:2px solid var(--text);outline-offset:2px}.gc-link{grid-column:1;font-size:13px;color:var(--dim)}.pl-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-bottom:16px}
.pl-tile{border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--surface-2);min-width:0}
.pl-tile span{display:block;font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.pl-tile b{display:block;font-family:var(--f-display);font-size:clamp(24px,3vw,34px);line-height:1.15;margin:4px 0 12px;font-weight:700;font-variant-numeric:tabular-nums}
.pl-tile.no b{color:var(--bad)}.pl-tile.yes b{color:var(--good)}
.pl-keep{display:flex;align-items:center;gap:20px;padding:18px 20px;border:1px solid var(--amber);border-radius:12px;background:color-mix(in srgb,var(--amber) 9%,var(--surface));margin-bottom:18px}
.pl-ring{flex:none;width:92px;height:92px;position:relative}
.pl-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.pl-ring circle{fill:none;stroke-width:9;stroke-linecap:round}
.pl-ring .tr{stroke:var(--line-strong);opacity:.5}
.pl-ring .fg{stroke:var(--good);transition:stroke-dashoffset .6s cubic-bezier(.2,.8,.2,1)}
.pl-ring em{position:absolute;inset:0;display:grid;place-items:center;font-style:normal;font-family:var(--f-display);font-weight:700;font-size:20px;font-variant-numeric:tabular-nums}
.pl-kt span{font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.pl-kt b{display:block;font-family:var(--f-display);font-size:clamp(32px,5vw,46px);line-height:1.05;color:var(--amber);font-weight:800;font-variant-numeric:tabular-nums}
.pl-kt small{color:var(--muted);font-size:13px}
.pl-tbl td:first-child,.pl-tbl th:first-child{text-align:left}.pl-tbl tr:last-child td{border-bottom:0;font-weight:600;color:var(--text)}
@media (max-width:480px){.pl-two{grid-template-columns:minmax(0,1fr)}.pl-keep{gap:14px;padding:16px}.pl-ring{width:76px;height:76px}}
.card.pl-one{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:0;padding:0}
.pl-main{padding:22px;min-width:0}
.pl-side{padding:22px;min-width:0;display:grid;gap:16px;align-content:start;border-left:1px solid var(--line)}
@media (max-width:1100px){.card.pl-one{grid-template-columns:minmax(0,1fr)}.pl-side{border-left:0;border-top:1px solid var(--line)}}
@media (max-width:560px){.pl-main,.pl-side{padding:16px}}
.cur{position:relative}
#curBtn{padding:0 10px;white-space:nowrap}
#curMenu{position:absolute;z-index:60;top:calc(100% + 6px);left:0;width:250px;max-height:min(60vh,420px);overflow-y:auto;margin:0;padding:6px;list-style:none;background:var(--surface);border:1px solid var(--line-strong);border-radius:12px;box-shadow:0 12px 32px rgba(0,0,0,.28)}
#curMenu[hidden]{display:none}
#curMenu button{display:flex;gap:10px;align-items:baseline;width:100%;padding:8px 10px;border:0;border-radius:8px;background:transparent;color:var(--text);font:inherit;font-size:14px;text-align:left;cursor:pointer}
#curMenu button b{width:38px;flex:none}#curMenu button span{color:var(--muted);font-size:13px}
#curMenu button:hover,#curMenu button:focus-visible{background:var(--surface-2)}
#curMenu button[aria-selected="true"]{background:var(--amber);color:#1a1206}#curMenu button[aria-selected="true"] span{color:#1a1206}
.cur-n{padding:8px 10px 4px;font-size:12px;color:var(--dim)}
@media (max-width:900px){#curMenu{left:auto;right:-70px}}
.menu{display:none}.crumb{display:none}
.menu .eyebrow{margin:24px 0 6px}
.m-sub{margin:0 0 18px;color:var(--muted);font-size:15px}
.m-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:12px;margin-bottom:14px}
.mcard{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:14px;width:100%;padding:14px 16px;text-align:left;font:inherit;color:var(--text);background:var(--surface);border:1px solid var(--line);border-radius:16px;cursor:pointer;transition:border-color .15s,transform .15s}
.mcard:hover,.mcard:focus-visible{border-color:var(--amber);transform:translateY(-1px)}
.mi{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;color:var(--amber);background:color-mix(in srgb,var(--amber) 16%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--amber) 35%,transparent)}
.mt{display:grid;gap:2px;min-width:0}
.mt small{font-family:var(--f-mono);font-size:11px;color:var(--amber);letter-spacing:.08em}
.mt b{font-size:17px;line-height:1.25}
.mt span{font-size:14px;color:var(--muted);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.mch{color:var(--dim);font-size:22px}
.crumb{justify-content:space-between;gap:12px;padding:14px 0}
.crumb button{border:1px solid var(--line-strong);background:var(--surface);color:var(--text);font:inherit;font-size:14px;font-weight:600;border-radius:999px;padding:9px 16px;cursor:pointer;max-width:70%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.crumb button[hidden]{display:none}
html:not([data-mode="lite"])[data-view="menu"] .sec,html:not([data-mode="lite"])[data-view="sec"] .sec{display:none!important}
html:not([data-mode="lite"])[data-view="sec"] .sec.cur{display:block!important}
html:not([data-mode="lite"])[data-view="menu"] .menu{display:block}
html:not([data-mode="lite"])[data-view="sec"] .crumb{display:flex}
html:not([data-mode="lite"])[data-view="sec"] .sec.cur{border-top:0;padding-top:8px}
@media print{html:not([data-mode="lite"])[data-view] .sec{display:block!important}.menu,.crumb{display:none!important}}
@media(max-width:900px){.m-grid{grid-template-columns:1fr}.mcard{padding:12px 14px}}
.gotabs{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.gotabs button{min-width:0}
@media(max-width:560px){.gotabs button{display:flex!important;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:10px 4px!important;font-size:14px!important;line-height:1.15;text-align:center;white-space:normal;min-height:64px}.gotabs button span{font-size:22px}}
.pn{display:grid;gap:16px;max-width:1040px}
@media(min-width:900px){.pn{grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);align-items:start}}
.pn-in,.pn-out{display:grid;gap:14px;min-width:0}
.pn-card,.pn-res,.pn-det,.pn-foot{background:var(--surface);border:1px solid var(--line);border-radius:20px}
.pn-card{padding:18px;display:grid;gap:14px}
.pn-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}
.pn-head h3{margin:0;font-size:22px}.pn-head p{margin:4px 0 0;color:var(--muted);font-size:14px}
.pn-seg{display:flex;padding:4px;border:1px solid var(--line-strong);border-radius:14px;background:var(--surface-2)}
.pn-seg button{border:0;background:transparent;color:var(--muted);font:inherit;font-weight:600;font-size:15px;padding:9px 14px;border-radius:10px;cursor:pointer;white-space:nowrap}
.pn-seg button.on{background:var(--amber);color:#1a1206}
.pn-box{border:1px solid var(--line);border-radius:16px;padding:16px;background:var(--surface-2);display:grid;gap:14px}
.pn-bl{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.pn-bl span{font-family:var(--f-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.pn-bl em{font-style:normal;color:var(--amber);font-weight:600;font-size:14px}
.pn-step{display:grid;grid-template-columns:56px 1fr 56px;align-items:center;gap:10px}
.pn-step button{height:56px;border-radius:16px;border:1px solid var(--line-strong);font:inherit;font-size:30px;font-weight:700;cursor:pointer;background:var(--surface);color:var(--text)}
.pn-step .pn-p{background:var(--amber);color:#1a1206;border-color:var(--amber);box-shadow:0 8px 20px color-mix(in srgb,var(--amber) 30%,transparent)}
.pn-num{text-align:center;display:grid;line-height:1.1}.pn-num b{font-size:44px;font-family:var(--f-display)}.pn-num span{color:var(--muted);font-size:15px}
.pn-q{display:flex;gap:8px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:14px}
.pn-q button,.pn-row .chip{border:1px solid var(--line-strong);background:var(--surface);color:var(--text);font:inherit;font-weight:600;font-size:14px;border-radius:12px;padding:9px 12px;cursor:pointer}
.pn-q button.on,.pn-row .chip.on{border-color:var(--amber);color:var(--amber);background:color-mix(in srgb,var(--amber) 12%,transparent)}
.pn-row{display:flex;justify-content:space-between;align-items:center;gap:12px;border:1px solid var(--line);border-radius:16px;padding:14px 16px;background:var(--surface-2)}
.pn-row b{font-size:16px}.pn-row small{display:block;color:var(--muted);font-size:14px;margin-top:3px}
.pn-row .chips{flex-wrap:nowrap}
.pn-badge{display:inline-block;margin-left:8px;padding:3px 9px;border-radius:8px;font-size:12px;font-weight:600;color:var(--amber);background:color-mix(in srgb,var(--amber) 14%,transparent)}
.pn-badge.g{color:var(--good);background:color-mix(in srgb,var(--good) 16%,transparent)}
.pn-sw{flex:none;width:62px;height:34px;border-radius:999px;border:0;background:var(--line-strong);position:relative;cursor:pointer;transition:background .15s}
.pn-sw::after{content:"";position:absolute;top:4px;left:4px;width:26px;height:26px;border-radius:50%;background:var(--text);transition:transform .15s}
.pn-sw[aria-checked="true"]{background:var(--amber)}.pn-sw[aria-checked="true"]::after{transform:translateX(28px);background:#1a1206}
.pn-res{padding:16px;display:grid;gap:14px;border-color:color-mix(in srgb,var(--amber) 45%,var(--line));background:linear-gradient(160deg,color-mix(in srgb,var(--amber) 9%,var(--surface)),var(--surface))}
.pn-two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.pn-tile{border:1px solid var(--line);border-radius:16px;padding:14px;background:var(--surface);display:grid;gap:4px;align-content:start;min-width:0}
.pn-tile span{font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.pn-tile b{font-size:clamp(24px,4.4vw,32px);line-height:1.1;font-family:var(--f-display);overflow-wrap:anywhere}
.pn-tile small{color:var(--muted);font-size:14px}
.pn-tile.sv{border-color:color-mix(in srgb,var(--good) 55%,var(--line))}.pn-tile.sv b{color:var(--amber)}.pn-tile.sv small{color:var(--good)}
.pn-bars{border:1px solid var(--line);border-radius:16px;padding:14px;background:var(--surface);display:grid;gap:10px}
.pn-bl2{display:flex;justify-content:space-between;align-items:center;gap:10px}
.pn-bl2 span{display:flex;align-items:center;gap:10px;font-weight:600}.pn-bl2 b{font-size:18px}
.pn-bl2 .bad{color:var(--bad)}.pn-bl2 .good{color:var(--good)}
.pn-bl2 .d{width:12px;height:12px;border-radius:50%;display:inline-block}.pn-bl2 .d.bad{background:var(--bad)}.pn-bl2 .d.good{background:var(--good)}
.pn-det{overflow:hidden}
.pn-det summary{list-style:none;cursor:pointer;padding:16px 18px;display:flex;justify-content:space-between;align-items:center}
.pn-det summary::-webkit-details-marker{display:none}
.pn-det summary::after{content:"";width:9px;height:9px;border:solid var(--muted);border-width:0 2px 2px 0;transform:rotate(45deg);margin-right:4px;transition:transform .15s}
.pn-det[open] summary::after{transform:rotate(-135deg)}
.pn-det summary b{display:block;font-size:17px}.pn-det summary small{display:block;color:var(--muted);font-size:14px;margin-top:2px}
.pn-tbl{width:100%;border-collapse:collapse;border-top:1px solid var(--line)}
.pn-tbl th{font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);text-align:right;padding:12px 14px;font-weight:500}
.pn-tbl th:first-child,.pn-tbl td:first-child{text-align:left;padding-left:18px}.pn-tbl th:last-child{color:var(--good)}
.pn-tbl td{padding:12px 14px;text-align:right;border-top:1px solid var(--line);font-weight:600;white-space:nowrap}
.pn-tbl td:first-child{white-space:normal}.pn-tbl td small{display:block;color:var(--muted);font-weight:400;font-size:13px}
.pn-tbl td:nth-child(2){color:var(--text)}.pn-tbl td:last-child{padding-right:18px}
.pn-tbl tr.tot td{font-size:16px}.pn-tbl tr.tot td:nth-child(2){color:var(--bad)}.pn-tbl tr.tot td:nth-child(3){color:var(--good)}
.pn-calc{padding:0 18px 16px;color:var(--muted);font-size:14px;display:grid;gap:8px}.pn-calc p{margin:0}
.pn-foot{padding:16px 18px;font-size:16px}.pn-foot span{font-weight:500}
.pn-row[hidden]{display:none!important}.pn-bl em{white-space:nowrap}
@media(max-width:560px){.pn-two{gap:10px}.pn-tile{padding:12px}.pn-seg button{padding:8px 11px}}
#s-projection{display:none!important}
.am-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:4px 0 14px}
.am-stats>div{border:1px solid var(--line);border-radius:14px;padding:12px;background:var(--surface-2);display:grid;gap:2px;min-width:0}
.am-stats span{font-family:var(--f-mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.am-stats b{font-size:15px;line-height:1.25}
.am-stats em{font-style:normal;font-size:20px;font-weight:800;font-family:var(--f-display)}
.am-stats em.g{color:var(--good)}.am-stats em.r{color:var(--bad)}
.am-leg{display:flex;flex-wrap:wrap;gap:8px 18px;justify-content:center;margin:6px 0 10px;font-size:14px;color:var(--muted)}
.am-leg span{display:flex;align-items:center;gap:7px}.am-leg i{width:14px;height:14px;border-radius:50%;display:inline-block}
.am-card .amap{width:100%;max-width:760px;margin:0 auto;display:block;height:auto}
@media(max-width:560px){.am-stats{grid-template-columns:1fr;}.am-stats>div{grid-template-columns:1fr auto;align-items:center}.am-stats span{grid-column:1/-1}}

.am-tabs{display:flex;gap:4px;padding:3px;border:1px solid var(--line-strong);border-radius:12px;background:var(--surface-2);margin:0 0 14px;max-width:360px}
.am-tabs button{flex:1;height:36px;border:0;border-radius:9px;background:transparent;color:var(--muted);font:inherit;font-size:14px;font-weight:600;cursor:pointer}
.am-tabs button[aria-pressed="true"]{background:var(--amber);color:var(--amber-ink)}
.am-detail{border:1px solid var(--line);border-radius:14px;background:var(--surface-2);padding:14px 16px;margin:10px 0 6px}
.am-d{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:12px}
.am-d h4{font:700 20px var(--f-display);margin:2px 0 4px}.am-d p{margin:0;color:var(--muted);font-size:14px}
.am-dn{text-align:right;display:grid;gap:2px;flex:none}.am-dn b{font:800 26px var(--f-display)}.am-dn small{color:var(--muted);font-size:12px}
.btn.ghostb{background:transparent;border:1px solid var(--line-strong);color:var(--text);cursor:pointer;font:inherit;font-weight:600;padding:9px 16px;border-radius:999px}
.am-chips{display:flex;gap:6px;overflow-x:auto;margin:0 -2px 10px;padding:0 2px 4px;scrollbar-width:none}.am-chips::-webkit-scrollbar{display:none}
.am-chips button{flex:0 0 auto;height:34px;padding:0 12px;border-radius:999px;border:1px solid var(--line-strong);background:var(--surface);color:var(--muted);font:inherit;font-size:13px;font-weight:600;cursor:pointer}
.am-chips button[aria-pressed="true"]{background:var(--amber);border-color:var(--amber);color:var(--amber-ink)}
.am-frame{width:100%;height:min(62vh,440px);border:1px solid var(--line);border-radius:14px;background:var(--surface-2);display:block}
.am-card .amap{max-width:640px}
.am-card g[data-ai]:focus-visible{outline:none}.am-card g[data-ai]:focus-visible circle{stroke:var(--text);stroke-width:3}

/* ===== App layout: five tabs, one section at a time ===== */
html[data-split] .app{display:block;max-width:900px;margin:0 auto}
html[data-split] .rail{position:sticky;top:env(safe-area-inset-top,0px);height:auto;z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);padding:12px 0 10px;gap:10px;border-bottom:1px solid var(--line)}
html[data-split] .top{flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 10px}
html[data-split] .brand{flex-direction:row;align-items:baseline;gap:10px;min-width:0}
html[data-split] .brand span{display:none}
html[data-split] .brand b{white-space:nowrap;font-size:19px}
@media(max-width:480px){html[data-split] .brand b{font-size:16px}html[data-split] .tools{gap:6px}html[data-split] .langsel{max-width:82px;padding-inline:6px}html[data-split] .brand{flex:1 1 auto}}
html[data-split] .tools{flex:none}
html[data-split] .modes,html[data-split] #nav,html[data-split] .readout,html[data-split] #menu,html[data-split] .crumb{display:none!important}
html[data-split][data-split] .sec:not(.cur){display:none!important}
html[data-split][data-split] .sec.cur{display:block!important;border-top:0;padding-block:22px 8px;animation:secIn .26s cubic-bezier(.2,.7,.2,1)}
@keyframes secIn{from{opacity:0;transform:translateY(8px)}}
html[data-split] .sec-head{margin-bottom:22px}
html[data-split] .main{padding-bottom:110px}
html[data-split] .gotabs{max-width:none}
html[data-split] .gotabs button{height:auto!important;flex-direction:column!important;gap:2px!important;min-height:66px}
html[data-split] .gotabs button .gl{display:flex;align-items:center;justify-content:center;gap:5px;font-size:14px;font-weight:700;flex-wrap:wrap;text-align:center}
html[data-split] .gotabs button .gl span{font-size:18px}
html[data-split] .gotabs button small{font:500 12px var(--f-body);opacity:.8}
#subnav{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;margin:0 -16px;padding:0 16px 2px}
#subnav::-webkit-scrollbar{display:none}
#subnav[hidden]{display:none}
#subnav button{flex:0 0 auto;height:36px;padding:0 14px;border-radius:999px;border:1px solid var(--line-strong);background:var(--surface);color:var(--muted);font:inherit;font-size:14px;font-weight:600;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
#subnav button[aria-current="true"]{background:var(--amber);border-color:var(--amber);color:var(--amber-ink)}
#dock{position:fixed;left:0;right:0;bottom:calc(12px + env(safe-area-inset-bottom,0px));display:flex;justify-content:center;padding:0 max(14px,env(safe-area-inset-right,0px)) 0 max(14px,env(safe-area-inset-left,0px));z-index:30;pointer-events:none}
#dock{bottom:0;padding:0;background:var(--surface);border-top:1px solid var(--line-strong)}
#dock div{pointer-events:auto;display:grid;grid-template-columns:repeat(5,1fr);width:100%;max-width:900px;padding:6px max(8px,env(safe-area-inset-right,0px)) calc(6px + env(safe-area-inset-bottom,0px)) max(8px,env(safe-area-inset-left,0px))}
#dock button{border:0;background:none;color:var(--muted);display:grid;justify-items:center;gap:2px;padding:6px 0;border-radius:12px;font:inherit;font-size:11px;font-weight:600;cursor:pointer;transition:color .2s}
#dock .ic{font-size:22px;line-height:1}
#dock button[aria-current="page"]{color:var(--amber)}
#dock button:focus-visible,#subnav button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}
#zm{position:fixed;right:max(14px,env(safe-area-inset-right,0px));bottom:calc(84px + env(safe-area-inset-bottom,0px));z-index:29;display:flex;align-items:center;gap:2px;border:1px solid var(--line-strong);background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:999px;padding:3px;box-shadow:0 8px 24px rgba(0,0,0,.28)}
#zm button{border:0;background:none;color:var(--text);font:inherit;font-weight:700;cursor:pointer;height:38px;min-width:38px;border-radius:999px;display:grid;place-items:center;padding:0 10px}
#zm button:hover{background:var(--surface-2)}
#zm .zv{font:500 12px var(--f-mono);color:var(--muted);min-width:44px;padding:0}
#zm .zo{font-size:15px}
#zm.shut .zc{display:none!important}
html[data-split] .golist{max-width:none}
#zm button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}
.instbtn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:52px;margin:0 0 12px;border:1px solid var(--amber);border-radius:16px;background:transparent;color:var(--amber);font:inherit;font-size:16px;font-weight:700;cursor:pointer}
.instbtn[hidden]{display:none}
@media(prefers-reduced-motion:reduce){html[data-split] .sec.cur{animation:none}}
a.btn{display:inline-block;text-decoration:none}
.pl-cta{display:flex;flex-wrap:wrap;gap:8px}
.skip{position:absolute;left:-999px;top:8px;z-index:100;padding:8px 14px;border-radius:8px;background:var(--amber);color:var(--amber-ink);font-weight:600}.skip:focus{left:8px}.main:focus{outline:none}@media print{.rail,.skip{display:none}.app{display:block}.sec{break-inside:avoid;display:block!important}body{background:#fff;color:#000}.card{box-shadow:none}}.app{display:grid;grid-template-columns:240px minmax(0,1fr);gap:48px;max-width:1360px;margin:0 auto}.rail{position:sticky;top:0;align-self:start;height:100vh;padding:28px 0;display:flex;flex-direction:column;gap:28px}.brand{display:flex;flex-direction:column;gap:2px}.brand b{font-family:var(--f-display);font-size:22px;font-weight:700}.brand span{font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}#nav{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px;overflow-y:auto}#nav a{display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:8px;color:var(--muted);text-decoration:none;font-size:14px}#nav a::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--line-strong);flex:none}#nav a:hover{color:var(--text)}#nav a.on{color:var(--text);background:var(--surface)}#nav a.on::before{background:var(--amber)}.readout{margin-top:auto;border-top:1px solid var(--line);padding-top:16px;display:flex;flex-direction:column;gap:2px}.readout span{font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.readout b{font-family:var(--f-display);font-size:28px;color:var(--amber)}.readout small{color:var(--muted);font-size:12px}.main{padding-bottom:80px;min-width:0}.sec{padding-block:56px;border-top:1px solid var(--line);scroll-margin-top:0}.sec:first-child{border-top:0;padding-top:36px}.sec-head{display:grid;gap:10px;margin-bottom:28px;max-width:70ch}.eyebrow{font-family:var(--f-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:flex;gap:10px;align-items:center;flex-wrap:wrap}.sec-head h2{font-size:clamp(28px,3.6vw,40px);line-height:1.08;font-weight:700}.sec-head p{color:var(--muted);font-size:16px}.tag{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;padding:3px 8px;border-radius:99px;border:1px solid currentColor}.t-s{color:var(--good)}.t-m{color:var(--amber)}.t-u{color:var(--food)}.g2,.g3,.g4{display:grid;gap:16px;min-width:0}.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}.g4{grid-template-columns:repeat(4,minmax(0,1fr))}.g21{display:grid;gap:16px;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr)}.stack{display:grid;gap:16px;align-content:start;min-width:0}.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px;min-width:0}.card h3{font-size:18px;font-weight:600;margin-bottom:14px}.cap{color:var(--muted);font-size:13px;margin-top:14px}.note-box{background:var(--surface-2);border-radius:10px;padding:14px 16px;color:var(--muted);font-size:14px}.note-box b{color:var(--text);font-weight:600}.hero-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:32px;align-items:start}.hero-copy{display:grid;gap:22px;align-content:start}.hero-copy h1{font-size:clamp(40px,5.6vw,72px);line-height:1;font-weight:800;letter-spacing:-.025em}.lead{font-size:18px;color:var(--muted);max-width:52ch}.kpis{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 28px}.stat{border-top:2px solid var(--line-strong);padding-top:10px;min-width:0}.stat span{font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.stat b{display:block;font-family:var(--f-display);font-size:clamp(26px,3vw,36px);line-height:1.15;color:var(--amber);font-weight:700;overflow-wrap:anywhere}.stat small{color:var(--muted);font-size:13px}.findings{margin-top:48px}.findings .stat b{color:var(--text)}.profile{display:grid;gap:16px}.profile-top{display:flex;gap:16px;align-items:center}.profile-top svg{width:132px;height:132px;flex:none}.profile-top p{color:var(--muted);font-size:13px}.profile-top b{display:block;font-family:var(--f-display);font-size:20px;color:var(--text);margin-bottom:2px}.field{display:grid;gap:6px}.field label{display:flex;justify-content:space-between;font-size:13px;font-weight:500;color:var(--muted);gap:10px}.field output{color:var(--amber);font-family:var(--f-mono);font-size:13px}input[type=range]{width:100%;accent-color:var(--amber);margin:0}select,input[type=number]{width:100%;background:var(--surface-2);color:var(--text);border:1px solid var(--line-strong);border-radius:10px;padding:10px 12px;font:inherit;font-size:15px}.chips{display:flex;flex-wrap:wrap;gap:6px}.chip{font:inherit;font-size:13px;font-weight:500;background:var(--surface-2);color:var(--text);border:1px solid var(--line-strong);border-radius:99px;padding:6px 12px;cursor:pointer}.chip:hover{border-color:var(--amber)}.chip.on{background:var(--amber);border-color:var(--amber);color:var(--amber-ink)}.chips-label{font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim)}.btn{font:inherit;font-weight:600;font-size:14px;background:var(--amber);color:var(--amber-ink);border:0;border-radius:10px;padding:10px 16px;cursor:pointer}.btn.alt{background:var(--surface-2);color:var(--text);border:1px solid var(--line-strong)}.rrw{position:relative;padding-bottom:26px}.rrw .gl{position:absolute;top:0;bottom:26px;width:1px;background:var(--line)}.rr{position:relative;margin-bottom:18px}.rr:last-of-type{margin-bottom:8px}.rr-h,.br-h{display:flex;justify-content:space-between;gap:12px;margin-bottom:7px;align-items:baseline}.rr-n,.br-h span{font-weight:500;min-width:0}.rr-n small,.br-h small{display:block;color:var(--muted);font-size:12px;font-weight:400}.rr-v,.br-h b{font-family:var(--f-mono);font-size:13px;color:var(--amber);white-space:nowrap;font-weight:500}.rr-t{position:relative;height:12px;background:var(--surface-2);border-radius:99px}.rr-b{position:absolute;top:0;height:100%;background:var(--amber);opacity:.55;border-radius:99px}.rr-m{position:absolute;top:-4px;width:4px;height:20px;background:var(--amber);border-radius:2px;margin-left:-2px;text-decoration:none}.rr-ax{position:absolute;left:0;right:0;bottom:0;height:20px}.rr-ax span{position:absolute;font-family:var(--f-mono);font-size:11px;color:var(--dim);transform:translateX(-50%);white-space:nowrap}.rr-ax span:first-child{transform:none}.rr-ax span:last-child{transform:translateX(-100%)}.br{margin-bottom:16px}.br-t{height:12px;background:var(--surface-2);border-radius:99px;overflow:hidden}.br-t i{display:block;height:100%;background:var(--amber);border-radius:99px;transition:width .35s}.br-t i.hot{background:var(--bad)}.br-t i.good{background:var(--good)}.br-t i.food{background:var(--food)}.br-t i.mute{background:var(--line-strong)}.tw{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:right;padding:10px 8px;border-bottom:1px solid var(--line);white-space:nowrap}th:first-child,td:first-child{text-align:left;white-space:normal}th{font-family:var(--f-mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:500}tr.hl td{color:var(--amber);font-weight:600}.rank{list-style:none;margin:0;padding:0}.rank li{display:grid;grid-template-columns:28px minmax(0,1fr) auto auto;gap:12px;align-items:baseline;padding:10px 0;border-bottom:1px solid var(--line)}.rank .rk{font-family:var(--f-mono);font-size:12px;color:var(--dim)}.rank .rx{font-family:var(--f-mono);font-size:12px;color:var(--muted)}.rank .rv{font-family:var(--f-mono);font-size:13px;color:var(--amber)}.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:13px;color:var(--muted);margin-bottom:16px}.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:baseline}.stackbar{display:flex;height:16px;border-radius:99px;overflow:hidden;background:var(--surface-2)}.stackbar i{display:block;height:100%}.sg-d{background:var(--amber)}.sg-f{background:var(--food)}.sg-c{background:var(--cover)}.kv{display:flex;flex-direction:column;gap:2px}.kv span{font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.kv b{font-family:var(--f-display);font-size:26px;color:var(--amber);font-weight:700}.kv small{color:var(--muted);font-size:13px}.kvs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.chart svg{display:block;max-width:100%;height:auto}.chart svg text{font-family:var(--f-mono)}.ax{fill:var(--dim);font-size:11px}.val{fill:var(--text);font-size:12px;font-weight:500;text-anchor:middle}.end{font-size:12px;font-weight:500}.gl-line{stroke:var(--line);stroke-width:1}.ref{stroke:var(--dim);stroke-width:1.5;stroke-dasharray:4 4}.ann{stroke:var(--bad);stroke-width:1.5;stroke-dasharray:3 4}.timeline{list-style:none;margin:0;padding:0;display:grid;gap:0}.timeline li{display:grid;grid-template-columns:96px minmax(0,1fr);gap:14px;padding:12px 0;border-bottom:1px solid var(--line)}.timeline time{font-family:var(--f-mono);font-size:12px;color:var(--amber);padding-top:2px}.checks{display:grid;gap:10px}.checks label{display:flex;gap:10px;align-items:center;font-size:14px;cursor:pointer}.checks input{accent-color:var(--amber);width:18px;height:18px;flex:none}.src{margin:0;padding-left:20px;display:grid;gap:6px;font-size:14px;color:var(--muted)}.gaps{margin:0;padding:0;list-style:none;display:grid;gap:10px}.gaps li{padding-left:18px;position:relative;color:var(--muted);font-size:14px}.gaps li::before{content:"";position:absolute;left:0;top:9px;width:8px;height:2px;background:var(--bad)}textarea{width:100%;min-height:160px;background:var(--surface-2);color:var(--text);border:1px solid var(--line-strong);border-radius:10px;padding:12px;font-family:var(--f-mono);font-size:12px;margin-top:14px}.msg{font-size:13px;color:var(--good);min-height:20px;margin-top:10px}.foot{color:var(--dim);font-size:13px;padding-top:32px;border-top:1px solid var(--line);max-width:80ch}.hh-ctl{display:grid;gap:14px}.days{display:flex;flex-wrap:wrap;gap:6px}.opt{display:flex;gap:10px;align-items:center;font-size:14px;cursor:pointer}.opt input{accent-color:var(--amber);width:18px;height:18px;flex:none}.hh-sum{color:var(--muted);font-size:14px;margin-top:16px}.hh-chart{display:flex;align-items:flex-end;gap:6px;height:150px;border-bottom:1px solid var(--line-strong)}.hh-col{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:4px;min-width:0}.hh-col b{font-family:var(--f-mono);font-size:11px;color:var(--text);font-weight:500}.hh-col i{display:block;width:100%;background:var(--amber);border-radius:6px 6px 0 0;min-height:2px}.hh-col.now i{background:var(--good)}.hh-ax{display:flex;gap:6px;margin-top:6px}.hh-ax span{flex:1;text-align:center;font-family:var(--f-mono);font-size:11px;color:var(--dim)}.hh-row{display:grid;grid-template-columns:140px minmax(0,1fr) 170px;gap:18px;padding:16px 0;border-bottom:1px solid var(--line);align-items:start}.hh-row:last-child{border-bottom:0}.hh-time{font-family:var(--f-mono);font-size:13px;color:var(--amber);display:grid;gap:2px}.hh-name{font-weight:600;font-size:16px}.hh-ver{margin-top:8px;font-size:12px;color:var(--muted)}.hh-meta{color:var(--muted);font-size:13px}.hh-deal{font-size:14px;margin-top:6px;display:grid;gap:2px}.hh-note{color:var(--muted);font-size:13px;margin-top:6px}.hh-src{font-size:12px;color:var(--muted);margin-top:8px;display:grid;gap:2px}.badge{display:inline-block;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;padding:3px 8px;border-radius:99px;border:1px solid currentColor;white-space:nowrap}.b-venue{color:var(--good)}.b-guide{color:var(--food)}.b-listing{color:var(--muted)}.b-conflict{color:var(--bad)}.live{font-family:var(--f-mono);font-size:11px;color:var(--good)}.legend-list{display:grid;gap:12px;font-