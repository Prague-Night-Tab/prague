<style>:root{--bg:#0d1015;--surface:#151a22;--surface-2:#1b212b;--line:#262d39;--line-strong:#394253;--text:#eef0f4;--muted:#9aa3b2;--dim:#8791a1;--amber:#eaa63a;--amber-ink:#1a1204;--food:#6ea8e0;--cover:#e07a90;--good:#5ccf9b;--bad:#f0806b;--coaster:#e9dcc0;--coaster-ink:#2a2113;--f-display:"Bricolage Grotesque","Arial Narrow",system-ui,sans-serif;--f-body:"Instrument Sans",system-ui,-apple-system,"Segoe UI",sans-serif;--f-mono:"JetBrains Mono",ui-monospace,Menlo,monospace;color-scheme:dark}@media(prefers-color-scheme:light){:root:not([data-theme=dark]){--bg:#f2f3f6;--surface:#ffffff;--surface-2:#f6f7f9;--line:#dfe3ea;--line-strong:#c4cad6;--text:#14181f;--muted:#566074;--dim:#5f697b;--amber:#eaa63a;--amber-ink:#1a1204;--amber-tx:#9e5c00;--food:#2c6cb0;--cover:#b44461;--good:#17805a;--bad:#c4432e;color-scheme:light}}:root[data-theme=light]{--bg:#f2f3f6;--surface:#ffffff;--surface-2:#f6f7f9;--line:#dfe3ea;--line-strong:#c4cad6;--text:#14181f;--muted:#566074;--dim:#5f697b;--amber:#eaa63a;--amber-ink:#1a1204;--amber-tx:#9e5c00;--food:#2c6cb0;--cover:#b44461;--good:#17805a;--bad:#c4432e;color-scheme:light}:root[data-theme=midnight]{--bg:#0a0f14;--surface:#111a22;--surface-2:#16212b;--line:#1d2b36;--line-strong:#2e4252;--text:#e8f1f2;--muted:#8fa3ab;--dim:#7a8f98;--amber:#3fd6c4;--amber-ink:#04211d;--food:#6ea8e0;--cover:#ff9bb8;--good:#5ccf9b;--bad:#f0806b;color-scheme:dark}:root[data-theme=rosenight]{--bg:#000000;--surface:#101010;--surface-2:#181818;--line:#262626;--line-strong:#3d3d3d;--text:#fafafa;--muted:#8a8a8a;--dim:#7c7c7c;--amber:#ff7a9c;--amber-ink:#000000;--food:#6ea8e0;--cover:#ff9bb8;--good:#5ccf9b;--bad:#f0806b;color-scheme:dark}:root[data-theme=sky]{--bg:#eef7f7;--surface:#ffffff;--surface-2:#f5fbfb;--line:#d3e6e6;--line-strong:#b3d2d2;--text:#0f2326;--muted:#4f6d70;--dim:#5f7c7f;--amber:#0b7a74;--amber-ink:#ffffff;--food:#2c6cb0;--cover:#b44461;--good:#17805a;--bad:#c4432e;color-scheme:light}:root[data-theme=rose]{--bg:#fbf1f3;--surface:#ffffff;--surface-2:#fdf6f7;--line:#efd9de;--line-strong:#dfb9c3;--text:#2a1419;--muted:#7a5560;--dim:#7f5f6b;--amber:#b8325a;--amber-ink:#ffffff;--food:#2c6cb0;--cover:#b44461;--good:#17805a;--bad:#c4432e;color-scheme:light}:root[data-theme=absinth]{--bg:#0c1a12;--surface:#13261b;--surface-2:#1a3224;--line:#22402f;--line-strong:#336049;--text:#e6f2e9;--muted:#8fae9a;--dim:#7f9f8b;--amber:#9be84a;--amber-ink:#0a1a05;--food:#6ea8e0;--cover:#ff9bb8;--good:#5ccf9b;--bad:#f0806b;color-scheme:dark}:root[data-theme=petrin]{--bg:#0b1220;--surface:#121c30;--surface-2:#18253d;--line:#223250;--line-strong:#344b73;--text:#e4ecfa;--muted:#8da0bf;--dim:#7e92b2;--amber:#6fb7ff;--amber-ink:#04162b;--food:#6ea8e0;--cover:#ff9bb8;--good:#5ccf9b;--bad:#f0806b;color-scheme:dark}:root[data-theme=amber]{--bg:#1a120a;--surface:#26190e;--surface-2:#2f2013;--line:#3d2b1a;--line-strong:#5a4228;--text:#f4e6cf;--muted:#b39770;--dim:#a38962;--amber:#f0a830;--amber-ink:#2a1700;--food:#6ea8e0;--cover:#ff9bb8;--good:#5ccf9b;--bad:#f0806b;color-scheme:dark}:root[data-theme=neon]{--bg:#0a0710;--surface:#160f22;--surface-2:#1d1530;--line:#2a1f40;--line-strong:#41306a;--text:#f3eaff;--muted:#9a87b8;--dim:#8c79ab;--amber:#ff3d9a;--amber-ink:#2a0516;--food:#6ea8e0;--cover:#ff9bb8;--good:#5ccf9b;--bad:#f0806b;color-scheme:dark}:root[data-theme=velvet]{--bg:#1c0a14;--surface:#2a1020;--surface-2:#34172a;--line:#46223a;--line-strong:#693553;--text:#f5e3ea;--muted:#b58a9b;--dim:#a67c8d;--amber:#e0b04a;--amber-ink:#2a1a00;--food:#6ea8e0;--cover:#ff9bb8;--good:#5ccf9b;--bad:#f0806b;color-scheme:dark}:root[data-theme=charles]{--bg:#efe6d6;--surface:#f9f3e7;--surface-2:#f4ecdb;--line:#e2d6bf;--line-strong:#cbb998;--text:#2b2118;--muted:#7d6b58;--dim:#85735f;--amber:#b5532f;--amber-ink:#ffffff;--food:#2c6cb0;--cover:#b44461;--good:#17805a;--bad:#c4432e;color-scheme:light}:root[data-theme=mono]{--bg:#000000;--surface:#101010;--surface-2:#181818;--line:#262626;--line-strong:#3d3d3d;--text:#fafafa;--muted:#8a8a8a;--dim:#7c7c7c;--amber:#f2ead0;--amber-ink:#000000;--food:#6ea8e0;--cover:#ff9bb8;--good:#5ccf9b;--bad:#f0806b;color-scheme:dark}:root[data-theme=monopink]{--bg:#000000;--surface:#101010;--surface-2:#181818;--line:#262626;--line-strong:#3d3d3d;--text:#fafafa;--muted:#8a8a8a;--dim:#7c7c7c;--amber:#e0218a;--amber-ink:#ffffff;--food:#6ea8e0;--cover:#ff9bb8;--good:#5ccf9b;--bad:#f0806b;color-scheme:dark}:root[data-theme=monovltava]{--bg:#000000;--surface:#101010;--surface-2:#181818;--line:#262626;--line-strong:#3d3d3d;--text:#fafafa;--muted:#8a8a8a;--dim:#7c7c7c;--amber:#0b7a74;--amber-ink:#ffffff;--food:#6ea8e0;--cover:#ff9bb8;--good:#5ccf9b;--bad:#f0806b;color-scheme:dark}:root[data-theme=sunset]{--bg:#1d1226;--surface:#2a1a33;--surface-2:#34213f;--line:#44304f;--line-strong:#614673;--text:#fbe9e1;--muted:#c19aa8;--dim:#b28d99;--amber:#ff7a59;--amber-ink:#2b0d05;--food:#6ea8e0;--cover:#ff9bb8;--good:#5ccf9b;--bad:#f0806b;color-scheme:dark}*{box-sizing:border-box}html{scroll-behavior:smooth}body{background:var(--bg);color:var(--text);font-family:var(--f-body);font-size:15px;line-height:1.5;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0;overflow-x:hidden}body:before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--bg)}h1,h2,h3{font-family:var(--f-display);margin:0;text-wrap:balance;letter-spacing:-.01em}p{margin:0}a{color:var(--amber-tx,var(--amber))}:focus-visible{outline:2px solid var(--amber);outline-offset:2px;border-radius:4px}.num,table,.rr-v,.br-h b,.kv b{font-variant-numeric:tabular-nums}.top{display:flex;flex-direction:column;gap:14px}.tools{display:flex;gap:8px}.langsel{flex:1;min-width:0;height:36px;padding:0 10px;border-radius:8px;border:1px solid var(--line-strong);background:var(--surface);color:var(--text);font:inherit;font-size:14px;cursor:pointer}.themebtn{flex:none;width:36px;height:36px;display:grid;place-items:center;border-radius:8px;border:1px solid var(--line-strong);background:var(--surface);color:var(--text);cursor:pointer;padding:0}.themebtn svg{width:18px;height:18px}.langsel:hover,.themebtn:hover{border-color:var(--amber)}.langsel:focus-visible,.themebtn:focus-visible{outline:2px solid var(--amber);outline-offset:2px}.ver{margin:10px 0 0;font-family:var(--f-mono);font-size:11px;letter-spacing:.06em;color:var(--dim)}:lang(ja) h1,:lang(zh) h1{letter-spacing:0;font-size:clamp(30px,4.2vw,52px)}.modes{display:flex;gap:4px;padding:3px;border:1px solid var(--line-strong);border-radius:10px;background:var(--surface);margin:0 0 14px}.modes button{flex:1;height:32px;border:0;border-radius:7px;background:transparent;color:var(--dim);font:inherit;font-size:14px;font-weight:600;cursor:pointer}.modes button[aria-pressed=true]{background:var(--amber);color:#1a1206}.modes button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}html[data-mode=lite] .sec:not(#s-go):not(#s-weekend):not(#s-happy):not(#s-food){display:none}.instbtn{display:none}html[data-mode=lite] .instbtn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:52px;margin:0 0 12px;border:1px solid var(--amber);border-radius:16px;background:transparent;color:var(--amber-tx,var(--amber));font:inherit;font-size:17px;font-weight:700;cursor:pointer}html[data-mode=lite] .instbtn[hidden]{display:none}.insthelp{margin:0 0 12px;padding:12px 14px;border-radius:12px;background:var(--surface);border:1px solid var(--line-strong);font-size:15px}.insthelp[hidden],html[data-mode=lite] .readout{display:none}html[data-mode=lite] .main{font-size:17px}html[data-mode=lite] .main p,html[data-mode=lite] .main li{line-height:1.6}html[data-mode=lite] .sec-head p{font-size:17px}@media(max-width:900px){.modes{margin:10px 0 0}}.amap{width:100%;height:auto;display:block;max-height:520px}.hh-now{margin:0 0 12px;font-size:15px}.wk{width:100%;border-collapse:collapse;font-size:13px}.wk th,.wk td{padding:7px 8px;text-align:center;white-space:nowrap;border-bottom:1px solid var(--line);color:var(--dim)}.wk th:first-child,.wk td:first-child{text-align:left;color:var(--text);position:sticky;left:0;background:var(--surface);white-space:normal;min-width:130px}.wk th.today,.wk td.today{background:color-mix(in srgb,var(--amber) 13%,var(--surface));color:var(--text)}.wk td.live{font-weight:700;color:var(--amber-tx,var(--amber))}.maps{display:inline-flex;flex-wrap:wrap;gap:4px 10px;font-size:13px}.maps.big{display:flex;margin:12px 0 0;font-size:14px;align-items:baseline}.maps small{flex-basis:100%;color:var(--dim);font-size:12px}.maps b{color:var(--text);font-weight:600}.vn{color:inherit;text-decoration:none;border-bottom:1px dotted var(--dim)}.vn:hover{color:var(--amber-tx,var(--amber))}.hh-note.warn{color:var(--bad);font-weight:600}#s-go{display:none}html[data-mode=lite] #s-go{display:block}html[data-mode=lite] #s-go .sec-head h2{font-size:clamp(34px,5vw,56px);line-height:1.02}.gotabs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:4px 0 18px;max-width:560px}.gotabs button{height:56px;border-radius:16px;border:1px solid var(--line-strong);background:var(--surface);color:var(--text);font:inherit;font-size:18px;font-weight:700;cursor:pointer}.gotabs button[aria-pressed=true]{background:var(--amber);border-color:var(--amber);color:#1a1206}.gotabs button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}.go-head{margin:0 0 12px;font-size:15px;color:var(--dim)}.golist{display:grid;gap:10px;max-width:760px}.gocard{display:grid;grid-template-columns:1fr auto;gap:6px 14px;align-items:center;padding:14px 16px;border:1px solid var(--line-strong);border-radius:16px;background:var(--surface)}.gc-main b{display:block;font-size:18px;line-height:1.2}.gc-main small{display:block;margin-top:3px;color:var(--dim);font-size:13.5px;line-height:1.4}.gc-pill{grid-column:1;justify-self:start;padding:3px 10px;border-radius:999px;font-size:12.5px;font-weight:700;background:color-mix(in srgb,var(--amber) 18%,transparent);color:var(--amber-tx,var(--amber))}.gc-pill.live{background:color-mix(in srgb,var(--good) 20%,transparent);color:var(--good)}.gc-go{grid-column:2;grid-row:1 / span 2;display:grid;place-items:center;min-width:64px;height:48px;padding:0 16px;border-radius:12px;background:var(--amber);color:#1a1206;font-weight:800;text-decoration:none}.gc-go:focus-visible{outline:2px solid var(--text);outline-offset:2px}.gc-link{grid-column:1;font-size:13px;color:var(--dim)}.pl-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-bottom:16px}.pl-tile{border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--surface-2);min-width:0}.pl-tile span{display:block;font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.pl-tile b{display:block;font-family:var(--f-display);font-size:clamp(24px,3vw,34px);line-height:1.15;margin:4px 0 12px;font-weight:700;font-variant-numeric:tabular-nums}.pl-tile.no b{color:var(--bad)}.pl-tile.yes b{color:var(--good)}.pl-keep{display:flex;align-items:center;gap:20px;padding:18px 20px;border:1px solid var(--amber);border-radius:12px;background:color-mix(in srgb,var(--amber) 9%,var(--surface));margin-bottom:18px}.pl-ring{flex:none;width:92px;height:92px;position:relative}.pl-ring svg{width:100%;height:100%;transform:rotate(-90deg)}.pl-ring circle{fill:none;stroke-width:9;stroke-linecap:round}.pl-ring .tr{stroke:var(--line-strong);opacity:.5}.pl-ring .fg{stroke:var(--good);transition:stroke-dashoffset .6s cubic-bezier(.2,.8,.2,1)}.pl-ring em{position:absolute;inset:0;display:grid;place-items:center;font-style:normal;font-family:var(--f-display);font-weight:700;font-size:20px;font-variant-numeric:tabular-nums}.pl-kt span{font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.pl-kt b{display:block;font-family:var(--f-display);font-size:clamp(32px,5vw,46px);line-height:1.05;color:var(--amber-tx,var(--amber));font-weight:800;font-variant-numeric:tabular-nums}.pl-kt small{color:var(--muted);font-size:13px}.pl-tbl td:first-child,.pl-tbl th:first-child{text-align:left}.pl-tbl tr:last-child td{border-bottom:0;font-weight:600;color:var(--text)}@media(max-width:480px){.pl-two{grid-template-columns:minmax(0,1fr)}.pl-keep{gap:14px;padding:16px}.pl-ring{width:76px;height:76px}}.card.pl-one{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:0;padding:0}.pl-main{padding:22px;min-width:0}.pl-side{padding:22px;min-width:0;display:grid;gap:16px;align-content:start;border-left:1px solid var(--line)}@media(max-width:1100px){.card.pl-one{grid-template-columns:minmax(0,1fr)}.pl-side{border-left:0;border-top:1px solid var(--line)}}@media(max-width:560px){.pl-main,.pl-side{padding:16px}}.cur{position:relative}#curBtn{padding:0 10px;white-space:nowrap}#curMenu{position:absolute;z-index:60;top:calc(100% + 6px);left:0;width:250px;max-height:min(60vh,420px);overflow-y:auto;margin:0;padding:6px;list-style:none;background:var(--surface);border:1px solid var(--line-strong);border-radius:12px;box-shadow:0 12px 32px #00000047}#curMenu[hidden]{display:none}#curMenu button{display:flex;gap:10px;align-items:baseline;width:100%;padding:8px 10px;border:0;border-radius:8px;background:transparent;color:var(--text);font:inherit;font-size:14px;text-align:left;cursor:pointer}#curMenu button b{width:38px;flex:none}#curMenu button span{color:var(--muted);font-size:13px}#curMenu button:hover,#curMenu button:focus-visible{background:var(--surface-2)}#curMenu button[aria-selected=true]{background:var(--amber);color:#1a1206}#curMenu button[aria-selected=true] span{color:#1a1206}.cur-n{padding:8px 10px 4px;font-size:12px;color:var(--dim)}@media(max-width:900px){#curMenu{left:auto;right:-70px}}.menu,.crumb{display:none}.menu .eyebrow{margin:24px 0 6px}.m-sub{margin:0 0 18px;color:var(--muted);font-size:15px}.m-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap: