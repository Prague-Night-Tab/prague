 <p class="note">Not affiliated with any organiser or venue. Always confirm times and tickets with the organiser.</p>`}window.__evAll=()=>u,window.__evCats=()=>i,window.__evUnsave=h=>{Y.sv.delete(h),Zt(),l()},window.__evSaved=()=>[...Y.sv],window.__evToggle=h=>{const F=!Y.sv.has(h);return F?Y.sv.add(h):Y.sv.delete(h),Zt(),document.querySelectorAll('[data-save="'+h+'"]').forEach(X=>{X.classList.toggle("on",F),X.textContent=F?"\u2665":"\u2661",X.setAttribute("aria-pressed",F)}),document.querySelectorAll("[data-saved] .n").forEach(X=>X.textContent=jt()),F},window.__evIsSaved=h=>Y.sv.has(h),window.__evIc=h=>(Wt[h.c]||Wt.fest)[0],window.__evById=h=>u.find(F=>String(F.id)===String(h)),window.__evToday=()=>{const h=le(),F=h.iso;return u.filter(X=>X._d.includes(F)).map(X=>{let I=3,_=X.t?X.t[0]:null,ne=X.t?X.t[1]:null;if(_!=null){if(ne<=h.min)return null;I=h.min>=_?0:1}return{d:X.d,c:X.c,id:X.id,n:X.n,v:X.v,lo:X.lo,hi:X.hi,free:!!X.free,ll:X.ll,og:!!X.og,st:I,a:_,b:ne}}).filter(Boolean).sort((X,I)=>X.st-I.st||X.og-I.og||(X.a||0)-(I.a||0)||(X.b||0)-(I.b||0))},l(),U(),ue(),ve(),Le(),Gt("find");{const h=document.createElement("button");h.className="chip",h.dataset.near=1,h.textContent="Near me",h.onclick=()=>window.__evNear(),te("ev-tabs").appendChild(h)}window.__evNear=()=>{navigator.geolocation&&navigator.geolocation.getCurrentPosition(h=>{Y.loc=[h.coords.latitude,h.coords.longitude],l(),U()},()=>{})};const Oe=a,je=h=>h.replace(/[.*+?^${}()|[\]\\]/g,"\\$&"),We=new Set(u.map(h=>h.n));u.forEach(h=>(h.src||[]).forEach(F=>We.add(F[0])));const re=["January","February","March","April","May","June","July","August","September","October","November","December"],Ee=[[/^(\d+) events and seasonal attractions from mid-November 2026 into early 2027, with dates, venues and ticket prices where the sources publish them\.$/,(h,F)=>F.t("{0} events and seasonal attractions from mid-November 2026 into early 2027, with dates, venues and ticket prices where the sources publish them.",h[1])],[/^(\d+)