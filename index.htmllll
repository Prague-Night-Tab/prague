#instSheet{position:fixed;inset:0;z-index:9999;display:flex;align-items:flex-end;justify-content:center;background:rgba(0,0,0,.55)}
#instSheet[hidden]{display:none}
#instSheet .box{width:100%;max-width:520px;max-height:92vh;overflow:auto;background:var(--surface);color:var(--text);border:1px solid var(--line-strong);border-radius:22px 22px 0 0;padding:20px 18px calc(22px + env(safe-area-inset-bottom,0px))}
@media(min-width:600px){#instSheet{align-items:center}#instSheet .box{border-radius:22px}}
#instSheet h3{margin:0 0 4px;font-size:21px}
#instSheet .sub{margin:0 0 14px;color:var(--muted);font-size:14px}
#instSheet .tabs{display:flex;gap:8px;margin-bottom:14px}
#instSheet .tabs button{flex:1;height:44px;border-radius:12px;border:1px solid var(--line-strong);background:transparent;color:var(--text);font:inherit;font-weight:700;font-size:15px;cursor:pointer}
#instSheet .tabs button[aria-pressed=true]{background:var(--amber);color:var(--amber-ink);border-color:var(--amber)}
#instSheet ol{list-style:none;margin:0;padding:0;display:grid;gap:10px}
#instSheet li{display:flex;gap:12px;align-items:center;background:var(--surface-2);border:1px solid var(--line);border-radius:14px;padding:12px}
#instSheet li i{flex:none;width:30px;height:30px;border-radius:50%;background:var(--amber);color:var(--amber-ink);display:grid;place-items:center;font:700 15px/1 inherit;font-style:normal}
#instSheet li span{font-size:15px;line-height:1.35}
#instSheet li svg{vertical-align:-4px;margin:0 2px}
#instSheet .warn{margin:12px 0 0;padding:10px 12px;border-radius:12px;background:var(--surface-2);border:1px solid var(--line);color:var(--muted);font-size:13px;line-height:1.4}
#instSheet .row{display:flex;gap:8px;margin-top:14px}
#instSheet .row button{flex:1;height:48px;border-radius:14px;font:inherit;font-weight:700;font-size:16px;cursor:pointer;border:1px solid var(--line-strong);background:transparent;color:var(--text)}
#instSheet .row button.pri{background:var(--amber);color:var(--amber-ink);border-color:var(--amber)}

.wk th.pr,.wk td.pr{white-space:nowrap;text-align:left;font-family:var(--f-mono);font-weight:600;color:var(--amber)}
.wk td.pr small{display:block;font:500 11px var(--f-body,inherit);color:var(--muted)}
.wk tr.incsep td{padding:14px 8px 6px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--line-strong)}
.wk td.dn{text-align:left;color:var(--muted);white-space:nowrap}
</style>
