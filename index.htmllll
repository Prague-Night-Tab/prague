async function loadTR(l){
if(l==="en"||TR[l])return;
try{
const b=Uint8Array.from(atob(TRZ[l]),c=>c.charCodeAt(0));
TR[l]=await new Response(new Blob([b]).stream().pipeThrough(new DecompressionStream("gzip"))).json();
}catch(e){TR[l]={}}
}
function pragueNow(){
try{
const z='Europe/Prague',d=new Date();
const dn=new Intl.DateTimeFormat('en-US',{timeZone:z,weekday:'long'}).format(d);
const p=new Intl.DateTimeFormat('en-GB',{timeZone:z,hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(d);
const g=x=>+p.find(y=>y.type===x).value;
return {day:Math.max(0,DAYEN.indexOf(dn)),min:g('hour')*60+g('minute')};
}catch(e){const d=new Date();return {day:(d.getDay()+6)%7,min:d.getHours()*60+d.getMinutes()}}
}
const hhRows=()=>hh.flatMap(v=>v.w.map(w=>[v.n,v.a,v.ad,v.ty,CONF[v.c],w.d.map(i=>DAYSL.en[i]).join(' '),w.f,w.t,w.x]));
function niceTicks(max,n){n=n||4;max=Math.max(max,1);const raw=max/n,p=Math.pow(10,Math.floor(Math.log10(raw))),m=raw/p;const step=(m<=1?1:m<=2?2:m<=5?5:10)*p;const out=[];for(let v=0;v<=max+step*0.001;v+=step)out.push(+v.toFixed(6));if(out[out.length-1]<max)out.push(out[out.length-1]+step);return out}
function rangeRows(items,max,step){
const tk=[];for(let v=0;v<=max;v+=step)tk.push(v);
const grid=tk.map(v=>`<i class="gl" style="left:${v/max*100}%"></i>`).join('');
const rows=items.map(it=>{
const mid=it.mid!=null?it.mid:null;
return `<div class="rr"><div class="rr-h"><span class="rr-n">${it.n}${it.note?`<small>${it.note}</small>`:''}</span><span class="rr-v">${it.lo===it.hi?money(it.lo):money(it.lo)+' – '+money(it.hi)}</span></div><div class="rr-t"><b class="rr-b" style="left:${it.lo/max*100}%;width:${Math.max((it.hi-it.lo)/max*100,1.4)}%"></b>${mid!=null?`<u class="rr-m" style="left:${mid/max*100}%"></u>`:''}</div></div>`}).join('');
const axis=`<div class="rr-ax">${tk.map(v=>`<span style="left:${v/max*100}%">${money(v)}</span>`).join('')}</div>`;
return `<div class="rrw">${grid}${rows}${axis}</div>`;
}
function barRows(items,o){
const mx=o.max||Math.max(1,...items.map(i=>i.v));
return items.map(i=>`<div class="br"><div class="br-h"><span>${i.n}${i.note?`<small>${i.note}</small>`:''}</span><b>${o.fmt(i.v)}</b></div><div class="br-t"><i class="${i.cls||''}" style="width:${Math.max(0,Math.min(100,i.v/mx*100))}%"></i></div></div>`).join('');
}
function kv(label,value,small){return `<div class="kv"><span>${label}</span><b>${value}</b>${small?`<small>${small}</small>`:''}</div>`}
function stat(label,value,small){return `<div class="stat"><span>${label}</span><b>${value}</b>${small?`<small>${small}</small>`:''}</div>`}
function lineChart(el,o){
const W=Math.max(300,Math.floor(el.clientWidth||640)),H=W<520?250:330;
const m={l:W<520?48:60,r:W<520?64:92,t:20,b:34};
const iw=W-m.l-m.r,ih=H-m.t-m.b;
const sx=x=>m.l+(x-o.x0)/(o.x1-o.x0)*iw,sy=y=>m.t+(o.y1-y)/(o.y1-o.y0)*ih;
let s=`<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="img" aria-label="${o.label}">`;
o.yt.forEach(v=>{s+=`<line x1="${m.l}" x2="${W-m.r}" y1="${sy(v)}" y2="${sy(v)}" class="gl-line"/><text x="${m.l-8}" y="${sy(v)+4}" text-anchor="end" class="ax">${o.yf(v)}</text>`});
o.xt.forEach(v=>{s+=`<text x="${sx(v)}" y="${H-10}" text-anchor="middle" class="ax">${v}</text>`});
(o.refs||[]).forEach(q=>{s+=`<line x1="${m.l}" x2="${W-m.r}" y1="${sy(q.y)}" y2="${sy(q.y)}" class="ref"/><text x="${m.l+6}" y="${sy(q.y)-6}" class="ax">${q.label}</text>`});
(o.ann||[]).forEach(a=>{s+=`<line x1="${sx(a.x)}" x2="${sx(a.x)}" y1="${m.t}" y2="${m.t+ih}" class="ann"/><text x="${sx(a.x)-6}" y="${m.t+12}" text-anchor="end" class="ax">${a.label}</text>`});
o.series.forEach(se=>{
const col=`var(${se.c})`;
if(se.line!==false&&se.pts.length>1)s+=`<polyline fill="none" style="stroke:${col}" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" points="${se.pts.map(p=>sx(p[0])+','+sy(p[1])).join(' ')}"/>`;
if(se.dots)se.pts.forEach(p=>{
s+=`<circle cx="${sx(p[0])}" cy="${sy(p[1])}" r="5" stroke-width="2.5" style="stroke:${col};fill:${se.hollow?'var(--bg)':col}"/>`;
if(se.vals)s+=`<text x="${sx(p[0])}" y="${sy(p[1])-12}" class="val">${se.vf(p[1])}</text>`;
});
if(se.end){const p=se.pts[se.pts.length-1];s+=`<text x="${sx(p[0])+10}" y="${sy(p[1])+4}" class="end" style="fill:${col}">${se.end}</text>`}
});
el.innerHTML=s+'</svg>';
}
function rCoaster(){
const n=P.d*P.w,shown=Math.min(n,30),groups=Math.ceil(shown/5);
let marks='';
const rows=groups>3?2:1;
for(let g=0;g<groups;g++){
const row=Math.floor(g/3),inRow=Math.min(3,groups-row*3),col=g%3;
const cx=120+(col-(inRow-1)/2)*62,cy=rows===2?(row===0?92:150):120;
const cnt=Math.min(5,shown-g*5);
for(let i=0;i<Math.min(4,cnt);i++){const x=cx-12+i*8;marks+=`<line x1="${x}" y1="${cy-17}" x2="${x}" y2="${cy+17}"/>`}
if(cnt===5)marks+=`<line x1="${cx-17}" y1="${cy+11}" x2="${cx+17}" y2="${cy-11}"/>`;
}
const tx='style="font-size:12px;fill:var(--coaster-ink);font-family:var(--f-mono)"';
const extra=n>30?`<text x="120" y="190" text-anchor="middle" ${tx}>${t('+{0} more',n-30)}</text>`:'';
const none=n===0?`<text x="120" y="126" text-anchor="middle" ${tx}>${t('no tab')}</text>`:'';
$('coaster').innerHTML=`<svg viewBox="0 0 240 240" role="img" aria-label="${t("Beer mat with {0} tally marks for this week's drinks",n)}"><circle cx="120" cy="120" r="114" style="fill:var(--coaster);stroke:var(--line-strong)" stroke-width="2"/><circle cx="120" cy="120" r="102" fill="none" style="stroke:var(--coaster-ink)" stroke-width="1.2" stroke-dasharray="2 5" opacity=".5"/><text x="120" y="54" text-anchor="middle" style="font-size:13px;letter-spacing:.2em;fill:var(--coaster-ink);font-family:var(--f-mono)">ČÁRKY</text><g style="stroke:var(--coaster-ink)" stroke-width="3.2" stroke-linecap="round">${marks}</g>${extra}${none}<text x="120" y="214" text-anchor="middle" style="font-size:11px;letter-spacing:.16em;fill:var(--coaster-ink);font-family:var(--f-mono)">${t('THIS WEEK')}</text></svg>`;
$('tabTitle').textContent=t('{0} this week',plural(n,'drink'));
$('tabSub').textContent=n?t('{0} on the tab, {1} a night.',money(wk()),money(night())):t('Raise the nights per week to start a tab.');
}
function rKpis(){
const dr=P.d*P.w*52;
$('kpis').innerHTML=[
stat(t('Per night'),money(night()),t('{0} × {1}',P.d,money(P.p))+(P.o?t(' + {0} other',money(P.o)):'')),
stat(t('Per month'),money(mo()),t('{0} a week',plural(P.w,'night'))),
stat(t('Per year'),money(yr()),t('about {0}',P.cur==='CZK'?eur(yr()):nf(yr())+' Kč')),
stat(t('Drinks a year'),nf(dr),dr?t('{0} each, all in',money(yr()/dr)):'')
].join('');
$('roYr').textContent=money(yr());
$('roSub').textContent=plural(P.d,'drink')+', '+t('{0} a week',plural(P.w,'night'));
}
function rFindings(){
const cheap=areas[0],dear=areas[areas.length-1];
const tot=nights.map(n=>n.cover+n.food+n.drinks),mn=Math.min(...tot),mx=Math.max(...tot);
$('findings').innerHTML=[
stat(t('Same pint, different street'),(dear.hi/cheap.lo).toFixed(0)+'×',t('{0} in Žižkov against {1} on Old Town Square.',money(cheap.lo),money(dear.hi))),
stat(t('Pint price, 2021 to 2024'),'+'+pct((trend[3][1]/trend[0][1]-1)*100),t('From {0} to {1} in Prague restaurants.',money(trend[0][1]),money(trend[3][1]))),
stat(t('One modelled night'),rng(mn,mx),t('From a local pub to a nightclub with cover.')),
stat(t('Cocktail at happy hour'),'−'+pct((1-135/260)*100),t('About 135 Kč against 260 Kč at a craft bar.'))
].join('');
}
function rPrices(){
$('priceRange').innerHTML=rangeRows(drinks.map(d=>({n:t(d.n),lo:d.lo,hi:d.hi,mid:d.avg})),320,80);
const dr=P.d*P.w*52;
$('priceTbl').innerHTML=`<tr><th>${t('Drink ')}</th><th>${t('Average')}</th><th>${t('Round of 4')}</th><th>${t('Per year ')}</th></tr>`+drinks.map(d=>`<tr><td>${t(d.n)}</td><td>${money(d.avg)}</td><td>${money(d.avg*4)}</td><td>${money(dr*d.avg+P.o*P.w*52)}</td></tr>`).join('');
}
const tAreas=()=>areas.map(a=>({...a,n:t(a.n),note:t(a.note)}));
const AM={tab:'price',sel:null};
const AMLL=[[50.0845,14.4560],[50.0660,14.4470],[50.0990,14.4440],[50.0710,14.4040],[50.0755,14.4420],[50.0860,14.4262],[50.0875,14.4213]];
const AMRIV=[[50.1150,14.4350],[50.1080,14.4360],[50.1010,14.4300],[50.0960,14.4240],[50.0920,14.4180],[50.0885,14.4125],[50.0865,14.4115],[50.0810,14.4085],[50.0750,14.4120],[50.0680,14.4155],[50.0640,14.4195],[50.0580,14.4180],[50.0520,14.4120],[50.0460,14.4090]];
const AMLM=[['Hradčany',50.0910,14.4005],['Vyšehrad',50.0640,14.4195]];
const amX=lo=>(lo-14.385)/0.09*660,amY=la=>(50.108-la)/0.048*548;
function rAreas(){
const ta=tAreas(),mx=Math.max(...areas.map(a=>a.mid)),mn=Math.min(...areas.map(a=>a.mid));
const lo=ta.find(a=>a.mid===mn),hi=ta.find(a=>a.mid===mx);
const colr=v=>v<=55?'var(--good)':v<=85?'var(--amber)':'var(--bad)';
$('amStats').innerHTML=`<div><span>${t('Cheapest')}</span><b>${lo.n}</b><em class="g">${money(lo.mid)}</em></div><div><span>${t('Dearest')}</span><b>${hi.n}</b><em class="r">${money(hi.mid)}</em></div><div><span>${t('Same pint, {0}× the price',fx(mx/mn,1))}</span><b>${t('Half litre of draught lager')}</b><em>${money(mx-mn)}</em></div>`;
document.querySelectorAll('#amTabs button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.am===AM.tab));
const live=AM.tab==='live';$('areaMap').hidden=live;$('amLive').hidden=!live;$('amLeg').hidden=live;
if(!live){
 const R=ta.map(a=>20+a.mid/mx*30),P=AMLL.map(p=>[amX(p[1]),amY(p[0])]),T=P.map(p=>p.slice());
 for(let k=0;k<90;k++)for(let i=0;i<P.length;i++)for(let j=i+1;j<P.length;j++){const dx=P[j][0]-P[i][0],dy=P[j][1]-P[i][1],d=Math.hypot(dx,dy)||.01,need=R[i]+R[j]+10;if(d<need){const f=(need-d)/2/d;P[i][0]-=dx*f;P[i][1]-=dy*f;P[j][0]+=dx*f;P[j][1]+=dy*f}}
 const river=AMRIV.map((p,i)=>(i?'L':'M')+amX(p[1]).toFixed(1)+' '+amY(p[0]).toFixed(1)).join('');
 $('areaMap').innerHTML=`<svg class="amap" viewBox="0 0 660 548" role="img" aria-label="${t('Price map')}"><path d="${river}" fill="none" stroke="var(--food)" stroke-width="22" stroke-linecap="round" stroke-linejoin="round" opacity=".28"/><text x="${amX(14.4190)-12}" y="${amY(50.0625)}" font-size="15" font-style="italic" fill="var(--dim)" text-anchor="end">Vltava</text>`+AMLM.map(m=>`<g opacity=".7"><circle cx="${amX(m[2])}" cy="${amY(m[1])}" r="3.5" fill="var(--dim)"/><text x="${amX(m[2])+8}" y="${amY(m[1])+4}" font-size="13" fill="var(--dim)">${m[0]}</text></g>`).join('')+ta.map((a,i)=>{const c=colr(a.mid),[x,y]=P[i],sel=AM.sel===i,moved=Math.hypot(x-T[i][0],y-T[i][1])>8;return `${moved?`<line x1="${T[i][0]}" y1="${T[i][1]}" x2="${x}" y2="${y}" stroke="var(--dim)" stroke-width="1.5"/><circle cx="${T[i][0]}" cy="${T[i][1]}" r="3" fill="var(--text)"/>`:''}<g data-ai="${i}" role="button" tabindex="0" aria-label="${a.n}: ${money(a.mid)}" style="cursor:pointer"><circle cx="${x}" cy="${y}" r="${R[i]+(sel?5:0)}" fill="${c}" opacity="${AM.sel==null||sel?.92:.55}" ${sel?'stroke="var(--text)" stroke-width="3"':''}/><text x="${x}" y="${y+5}" text-anchor="middle" font-size="${R[i]>26?16:14}" font-weight="800" fill="#0b0e14" pointer-events="none">${money(a.mid)}</text><text x="${x}" y="${y+R[i]+18}" text-anchor="middle" font-size="15" font-weight="600" fill="var(--text)" stroke="var(--bg)" stroke-width="4" paint-order="stroke" pointer-events="none">${a.n}</text></g>`}).join('')+'</svg>';
 $('amLeg').innerHTML=`<span><i style="background:var(--good)"></i>${t('Up to {0}',money(55))}</span><span><i style="background:var(--amber)"></i>${rng(56,85)}</span><span><i style="background:var(--bad)"></i>${t('Over {0}',money(85))}</span>`;
}else{
 const s=AM.sel==null?0:AM.sel,q=encodeURIComponent('pubs in '+areas[s].n+', Praha');
 $('amLive').innerHTML=`<div class="am-chips">${ta.map((a,i)=>`<button type="button" data-live="${i}" aria-pressed="${i===s}">${a.n}</button>`).join('')}</div><iframe class="am-frame" title="Google Maps: ${areas[s].n}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=${q}&output=embed&hl=${LANG}"></iframe><p class="cap">${t('The live map loads from Google. If it stays blank, your browser or the host of this page blocks embedded maps. Open it in Google Maps instead.')}</p>`;
}
const si=AM.sel;
$('amDetail').innerHTML=si==null?`<p class="cap" style="margin:0">${t('Tap an area for details.')}</p>`:(()=>{const a=ta[si];return `<div class="am-d"><div><span class="eyebrow">${t('Range')}</span><h4>${a.n}</h4><p>${a.note}</p></div><div class="am-dn"><b style="color:${colr(a.mid)}">${money(a.mid)}</b><small>${rng(areas[si].lo,areas[si].hi)}</small><small>${t('{0}× the cheapest area',fx(a.mid/mn,1))}</small></div></div><div class="pl-cta"><a class="btn" href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('pub '+areas[si].n+', Praha')}" target="_blank" rel="noopener">${t('Search pubs here on Google Maps')}</a>${AM.tab==='price'?`<button type="button" class="btn ghostb" data-live="${si}">${t('Show on Google map')}</button>`:''}</div>`})();
const incV=hhInc.map(v=>{const m=v.w.match(/^([^.]*?),\s*(Praha\s*\d+)\./);return {n:v.n,a:m?m[2]:'Praha 1',ad:m?m[1]:''}});
$('mapAll').innerHTML=gmChunks([...hh,...incV],t('Show only the {0} listed bars on Google Maps:',hh.length+incV.length));
$('mapOpen').innerHTML='<b>'+t('Open Prague in')+'</b> '+mapLinks('bars, Praha');
}
function rCock(){
$('cockRange').innerHTML=rangeRows(cocktails.map(c=>({...c,n:t(c.n),note:c.note?t(c.note):''})),320,80);
if($('barRange'))$('barRange').innerHTML=rangeRows(namedBars.map(c=>({...c,n:t(c.n),note:c.note?t(c.note):''})),400,100);
$('extraTbl').innerHTML=`<tr><th>${t('Item')}</th><th>${t('Price')}</th></tr>`+extras.map(e=>`<tr><td>${t(e.n)}</td><td>${e.k==='from'?t('from {0}',money(e.lo)):e.k==='about'?t('about {0}',money(e.lo)):rng(e.lo,e.hi)}</td></tr>`).join('');
const h=hhData[S.hhT],sv=h.full-h.hh,perNight=S.hhN*sv,perYear=perNight*P.w*52;
$('o-hh').textContent=S.hhN;
$('hhOut').innerHTML=kv(t('Saved per drink'),money(sv),t('{0} down to {1}',money(h.full),money(h.hh)))+kv(t('Saved per night'),money(perNight),t('{0} × {1} at happy hour',S.hhN,t(h.n)))+kv(t('Saved per year'),money(perYear),t('{0} a week',plural(P.w,'night')))+kv(t('Share of a drink'),pct(sv/h.full*100),t('taken off the normal price'));
}
const VERD=new Date(2026,10,9),PARTV=['Cash Only','Zlatý Strom','Rossopomodoro','Bistro U dvou','La Bodeguita','Cafe 80','Station Anděl','OPSO'];
const verHtml=v=>`<div class="hh-ver">${PARTV.some(x=>v.n.startsWith(x))?t('Partly checked'):t('Checked {0}',VERD.toLocaleDateString(LOC(),{day:'numeric',month:'short',year:'numeric'}))}</div>`;
function rHappy(){
const now=pragueNow(),day=HH.day,isToday=day===now.day;
const hm=m=>String(Math.floor(m/60)%24).padStart(2,'0')+':'+String(m%60).padStart(2,'0');
document.querySelectorAll('#hhDays .chip').forEach((b,i)=>b.classList.toggle('on',i===day));
const own=v=>v.w.filter(w=>w.d.includes(day)).map(w=>({f:tm(w.f),t:wEnd(w),fs:w.f,ts:w.t,x:w.x}));
const spill=v=>v.w.filter(w=>w.d.includes((day+6)%7)&&wEnd(w)>1440).map(w=>({f:0,t:wEnd(w)-1440}));
let base=hh.map(v=>({v,ws:own(v).sort((a,b)=>a.f-b.f),sp:spill(v)})).filter(x=>x.ws.length);
if(HH.conf)base=base.filter(x=>x.v.c==='venue');
const live=x=>isToday&&(x.ws.some(w=>now.min>=w.f&&now.min<w.t)||x.sp.some(w=>now.min>=w.f&&now.min<w.t));
const rows=(HH.open?base.filter(live):base).sort((a,b)=>a.ws[0].f-b.ws[0].f);
const hours=r(12,23),counts=hours.map(h=>base.filter(x=>x.ws.some(w=>w.f<(h+1)*60&&w.t>h*60)).length);
const mx=Math.max(1,...counts),peak=Math.max(...counts),peakH=hours[counts.indexOf(peak)],nowH=isToday?Math.floor(now.min/60):-1;
$('hhChart').innerHTML=`<div class="hh-chart" role="img" aria-label="${t('Number of places with a happy hour in each hour of {0}, from 12:00 to 24:00',DAYL[day])}">${hours.map((h,i)=>`<div class="hh-col${h===nowH?' now':''}"><b>${counts[i]}</b><i style="height:${Math.round(counts[i]/mx*110)}px"></i></div>`).join('')}</div><div class="hh-ax">${hours.map(h=>`<span>${h}</span>`).join('')}</div>`;
$('hhSum').textContent=t('{0}: {1} of {2} listed places have a happy hour',DAYL[day],base.length,hh.length)+(peak?t(', most at {0} ({1})',hm(peakH*60),plural(peak,'place')):'')+t('. It is {0} {1} in Prague.',DAYL[now.day],hm(now.min));
$('hhListTitle').textContent=HH.open?t('Running now, {0} {1} ({2})',DAYL[day],hm(now.min),rows.length):t('{0} ({1})',DAYL[day],rows.length);
$('hhList').innerHTML=rows.length?rows.map(x=>{
const v=x.v,deals=[...new Set(x.ws.map(w=>w.x))],multi=x.ws.length>1&&deals.length>1;
const dealHtml=multi?x.ws.map(w=>`<span>${w.fs}–${w.ts}: ${t(w.x)}</span>`).join(''):deals.map(d=>`<span>${t(d)}</span>`).join('');
return `<div class="hh-row"><div class="hh-time">${x.ws.map(w=>`<span>${w.fs}–${w.ts}</span>`).join('')}${live(x)?`<span class="live">${t('On now')}</span>`:''}</div><div><div class="hh-name">${v.n}</div><div class="hh-meta">${t(v.ty)}, ${v.a}, ${v.ad} · <span class="maps">${t('Map')}: ${mapLinks(v.n+', '+v.ad+', Praha')}</span></div><div class="hh-deal">${dealHtml}</div>${v.warn?`<p class="hh-note warn">${t(WARN)}</p>`:''}${v.note?`<p class="hh-note">${t(v.note)}</p>`:''}</div><div><span class="badge b-${v.c}">${t(CONF[v.c])}</span><div class="hh-src">${v.src.map(k=>`<a href="${srcUrl(k,v)}" target="_blank" rel="noopener">${t(SRC[k][0])}</a>`).join('')}</div>${verHtml(v)}</div></div>`}).join('')
:`<p class="cap" style="margin:0">${HH.open?t('No listed place has a happy hour running right now. Try another day.'):t('No listed place has a happy hour on this day with these filters.')}</p>`;
$('hhMapsDay').innerHTML=gmChunks(rows.map(x=>x.v),t('Show only the bars in this list on Google Maps:'));
const ps=hh.filter(v=>v.p!=null).map(v=>v.p),min=Math.min(...ps),cheap=hh.find(v=>v.p===min);
const cnt={};ps.forEach(p=>cnt[p]=(cnt[p]||0)+1);
const mode=+Object.keys(cnt).sort((a,b)=>cnt[b]-cnt[a]||a-b)[0];
$('hhStats').innerHTML=kv(t('Venues listed'),hh.length,t('plus {0} with incomplete times',hhInc.length))+kv(t('Confirmed on venue site'),hh.filter(v=>v.c==='venue').length,t('of {0} listed',hh.length))+kv(t('Cheapest cocktail'),money(min),cheap.n)+kv(t('Most common price'),money(mode),t('quoted at {0}',plural(cnt[mode],'place')));
const ladder=hh.filter(v=>v.p!=null).sort((a,b)=>a.p-b.p).map(v=>({n:v.n,v:v.p,cls:v.c==='venue'?'good':v.c==='conflict'?'hot':''}));
ladder.push({n:t('Craft bar, normal price'),note:t('Midpoint of 220–300 Kč'),v:260,cls:'mute'});
$('hhLadder').innerHTML=barRows(ladder,{max:280,fmt:v=>money(v)});
rWeek();
rGo();
$('hhInc').innerHTML=hhInc.map(v=>`<li><b style="color:var(--text);font-weight:600">${v.n}.</b>${GRATE[v.n]?` <span style="color:var(--accent);font-weight:700">★ ${GRATE[v.n][0].toFixed(1)}</span> <span class="cap">(${GRATE[v.n][1].toLocaleString(LOC())})</span>.`:''} ${t(v.w)} <a href="${srcUrl(v.s,v)}" target="_blank" rel="noopener">${t(SRC[v.s][0])}</a></li>`).join('');
}
const MAPS=[['Google Maps','https://www.google.com/maps/search/?api=1&query='],['Apple Maps','https://maps.apple.com/?q='],['Mapy.cz','https://mapy.cz/zakladni?q='],['OpenStreetMap','https://www.openstreetmap.org/search?query=']];
const mapLinks=q=>MAPS.map(m=>`<a href="${m[1]}${encodeURIComponent(q)}" target="_blank" rel="noopener">${m[0]}</a>`).join('');
function gmChunks(vs,lead){
const L=[...vs].sort((a,b)=>(parseInt(a.a.replace(/\D+/g,''))||0)-(parseInt(b.a.replace(/\D+/g,''))||0)||a.n.localeCompare(b.n));
if(!L.length)return '';
const q=v=>encodeURIComponent(v.n+', '+v.ad+', Praha');
const out=[];
for(let i=0;i<L.length;i+=10){
const c=L.slice(i,i+10),from=i+1,to=i+c.length;
const url=c.length===1?'https://www.google.com/maps/search/?api=1&query='+q(c[0]):'https://www.google.com/maps/dir/?api=1&travelmode=walking&origin='+q(c[0])+'&destination='+q(c[c.length-1])+(c.length>2?'&waypoints='+c.slice(1,-1).map(q).join('%7C'):'');
out.push(`<a href="${url}" target="_blank" rel="noopener">${L.length>10?t('Bars {0}–{1}',from,to):t('Open map')}</a>`);
}
return '<b>'+lead+'</b> '+out.join('')+(L.length>1?'<small>'+t('Google shows each bar as a lettered stop on a walking route, up to 10 per link.')+'</small>':'');
}
function rWeek(){
const now=pragueNow(),hm=m=>String(Math.floor(m/60)%24).padStart(2,'0')+':'+String(m%60).padStart(2,'0');
const sh=s=>s.endsWith(':00')?s.slice(0,2):s;
const liveW=(v,dd)=>v.w.some(w=>{const f=tm(w.f),e=wEnd(w);return (w.d.includes(dd)&&now.min>=f&&now.min<e)||(w.d.includes((dd+6)%7)&&e>1440&&now.min<e-1440)});
const lv=hh.filter(v=>liveW(v,now.day));
$('hhNowLine').innerHTML=lv.length?'<b>'+t('Running now, {0} {1} ({2})',DAYL[now.day],hm(now.min),lv.length)+':</b> '+lv.map(v=>v.n).join(', '):t('No listed place has a happy hour running right now. Try another day.');
const PRH={'Déjávu Music Bar':'50% off','The Pitch':'50% off','Station Anděl':'under:100','Rossopomodoro Vinohrady':'1+1','Bistro U dvou kamarádů':'1+1','Pivovar U Supa':'Free beer'};
const KIND={'Kavárna Velryba':'drink','Pivovar U Supa':'beer','Bistro U dvou kamarádů':'drink'};
const prTxt=pr=>pr==null?'·':Array.isArray(pr)?money(pr[0])+'–'+money(pr[1]):typeof pr==='number'?money(pr):pr.startsWith('under:')?t('Under {0}',money(+pr.slice(6))):t(pr);
const prCell=(pr,k)=>`<td class="pr">${prTxt(pr)}${pr!=null&&k?`<small>${t(k)}</small>`:''}</td>`;
$('hhWeek').innerHTML='<tr><th>'+t('Venue')+'</th><th class="pr">'+t('Price')+'</th>'+DAYS.map((x,i)=>`<th class="${i===now.day?'today':''}">${x}</th>`).join('')+'</tr>'+hh.map(v=>{const pr=v.p!=null?v.p:(PRH[v.n]||null);return '<tr><td><a class="vn" href="https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(v.n+', '+v.ad+', Praha')+'" target="_blank" rel="noopener">'+v.n+'</a></td>'+prCell(pr,KIND[v.n]||'cocktail')+r(0,6).map(dd=>{const ws=v.w.filter(w=>w.d.includes(dd));const on=dd===now.day&&liveW(v,dd);return `<td class="${dd===now.day?'today':''}${on?' live':''}">${ws.length?ws.map(w=>sh(w.f)+'–'+sh(w.t)).join('<br>'):'·'}</td>`}).join('')+'</tr>'}).join('')
+'<tr class="incsep"><td colspan="9">'+t('Days not stated in the listing')+'</td></tr>'+hhInc.map(v=>{const mm=v.w.match(/^([^.]*?),\s*(Praha\s*\d+)\./),iv={a:mm?mm[2]:'Praha 1',ad:mm?mm[1]:''};return '<tr class="inc"><td><a class="vn" href="https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(v.n+', '+(iv.ad||iv.a)+', Praha')+'" target="_blank" rel="noopener">'+v.n+'</a></td>'+prCell(v.pr,v.k)+'<td class="dn" colspan="7">'+(v.hr?v.hr:t('Hours not stated'))+'</td></tr>'}).join('');
}
const clubGuide=[
{n:'Le Valmont',q:'Le Valmont, Uhelný trh 414/9, Praha',a:'Praha 1',cover:[0,0],note:'Free entry. Opens 20:00 Wednesday to Saturday in 2025 posts. Confirm before you go.',site:'https://levalmont.cz/'},
{n:'Duplex',q:'Duplex, Václavské náměstí 21, Praha',cover:[300, 400],note:'Open daily 22:00 to 05:00 on Wenceslas Square. Price depends on the event. One guide quotes 300 to 400 Kč at weekends.',site:'https://www.duplex.cz/'},
{n:'M1 Lounge',q:'M1 Lounge Bar & Club, Masná 1, Praha',cover:[0, 150],note:'Open Wednesday to Sunday from 22:00, until 06:00 on Friday and Saturday. A Swag & Save ticket gives free entry and a cocktail Sunday to Thursday 23:30 to 02:00. A guide quotes 0 to 150 Kč.',site:'https://www.m1lounge.com/'},
{n:'Moon Club',q:'Moon Club, Dlouhá 26, Praha',cover:null,note:'Open Wednesday to Saturday from 21:00 on Dlouhá, per a city listing. No current price found. A 2022 listing said free before 23:00. Check it is open.',site:'https://www.moonclub.cz/'},
{n:'OX Club',q:'OX Club, Francouzská 4, Praha',cover:[300, 390],note:'Tickets are sold per event, for example 300 Kč early tickets and from 390 Kč. Open mostly Friday and Saturday, per a city listing. Check before you go.',site:'https://www.oxclubprague.com/'},
{n:'Cross Club',q:'Cross Club, Praha',cover:[0,100],note:'Usually free, small charge for live acts'},
{n:'Lucerna Music Bar',q:'Lucerna Music Bar, Praha',cover:[100,100],note:'80s and 90s party nights Friday and Saturday at 22:00, tickets at the door. Concerts cost more.'},
{n:'Karlovy Lázně',q:'Karlovy Lázně club, Praha',cover:[100,300],note:'Five floors near Charles Bridge. Opens at 22:00 every day. One guide quotes 100 to 200 Kč, another 300 Kč at weekends.'},
{n:'Roxy',q:'Roxy, Dlouhá 33, Praha',cover:[100, 400],note:'Dlouhá 33. Free Monday. One guide quotes 100 to 150 Kč, another 200 to 400 Kč on Saturdays at the door. Indie, house, techno and drum and bass.'},
{n:'Chapeau Rouge',q:'Chapeau Rouge, Jakubská 2, Praha',cover:[0, 200],note:'Jakubská 2. Free before 23:00 and 100 to 200 Kč after, per one guide. Club floors open Thursday to Saturday 22:00 to 05:00. Pilsner Urquell 0.5 l 70 Kč.'},
{n:'EPIC Prague',q:'EPIC Prague, Revoluční 5, Praha',cover:[200, 400],note:'Revoluční 5. 200 to 300 Kč before midnight and 400 Kč after. Headliner nights 600 to 800 Kč. Table minimum 5,000 Kč for four.'},
{n:'Ankali',q:'Ankali, U Plynárny 1290/99, Praha',cover:[150, 500],note:'U Plynárny 99, Vršovice. Techno. 150 to 350 Kč or 250 to 500 Kč depending on the guide and line-up. Doors 23:00. One guide warns it may be closing, so confirm it is open.'},
{n:'Fuchs2',q:'Fuchs2, Rohanský ostrov, Praha',cover:[400, 400],note:'Rohanský ostrov, Karlín. Hardcore industrial techno. 400 Kč, per one guide. Regulars stay until 06:00.'},
{n:'Storm Club',q:'Storm Club, Tachovské náměstí 5, Praha',cover:[100, 150],note:'Tachovské náměstí 5, Žižkov. Drum and bass. Often open past sunrise on Saturdays.'},
{n:'Bike Jesus',q:'Bike Jesus, Bořivojova 86, Praha',cover:[250, 250],note:'Bořivojova 86, Žižkov. Cellar venue with hardcore and techno. Drinks from 60 Kč.'},
{n:'Jazz Dock',q:'Jazz Dock, Praha',cover:[150, 350],note:'Live jazz on the Vltava in Smíchov. The price depends on the artist. Late sets from about 22:00.'},
{n:'Termix',q:'Termix, Třebízského 4, Praha',cover:null,note:'Třebízského 4, Vinohrady. LGBTQ+ club. No cover price found.'},
{n:'Valentino',q:'Valentino, Vinohradská 40, Praha',cover:null,note:'Vinohradská 40, Vinohrady. LGBTQ+ club. No cover price found.'}];
const gmUrl=q=>'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(q);
const UPD={"Le Valmont": ["Venue site: newest post {0}", "2025-08"], "Duplex": ["Venue site: page edited {0}", "2026-10-19"], "M1 Lounge": ["Venue site: no update date shown", null], "Moon Club": ["Venue site: events listed up to {0}", "2026-12-31"], "OX Club": ["Venue site: events listed up to {0}", "2027-04-17"], "Cross Club": ["Venue site not checked", null], "Lucerna Music Bar": ["Venue site: no update date shown", null], "Karlovy Lázně": ["Venue site: no update date shown", null], "Roxy": ["Listed by a local guide, not the venue site", null, "2026-11-14"], "Chapeau Rouge": ["Listed by a local guide, not the venue site", null, "2026-11-14"], "EPIC Prague": ["Listed by a local guide, not the venue site", null, "2026-11-14"], "Ankali": ["Listed by a local guide, not the venue site", null, "2026-11-14"], "Fuchs2": ["Listed by a local guide, not the venue site", null, "2026-11-14"], "Storm Club": ["Listed by a local guide, not the venue site", null, "2026-11-14"], "Bike Jesus": ["Listed by a local guide, not the venue site", null, "2026-11-14"], "Jazz Dock": ["Listed by a local guide, not the venue site", null, "2026-11-14"], "Termix": ["Listed by a local guide, not the venue site", null, "2026-11-14"], "Valentino": ["Listed by a local guide, not the venue site", null, "2026-11-14"], };
const updLine=c=>{const u=UPD[c.n]||['Venue site: no update date shown',null];const f=d=>new Date((d.length===7?d+'-15':d)+'T12:00:00').toLocaleDateString(LANG==='en'?'en-GB':LANG,d.length===7?{month:'short',year:'numeric'}:{day:'numeric',month:'short',year:'numeric'});return t(u[0],u[1]?f(u[1]):'')+' · '+t('Checked {0}',f(u[2]||'2026-11-12'))};
function clubCards(){
return clubGuide.map(c=>`<div class="gocard"><div class="gc-main"><b>${c.n}</b><small>${t(c.note)}</small>${rtHtml(c.n)}<small style="color:var(--dim);font-size:12px">${updLine(c)}</small></div><span class="gc-pill">${c.cover?(c.cover[1]===0?t('Free entry'):c.cover[0]===c.cover[1]?money(c.cover[0]):money(c.cover[0])+'–'+money(c.cover[1])):t('Cover not listed')}</span><a class="gc-go" href="${gmUrl(c.q)}" target="_blank" rel="noopener">${t('Go')}</a>${c.site?`<a class="gc-link" href="${c.site}" target="_blank" rel="noopener">${c.site.replace(/^https?:\/\/|\/$/g,'')}</a>`:''}</div>`).join('');
}
let GO='hh';
function hhState(v){
const n=pragueNow();
for(const w of v.w){const e=wEnd(w);if(w.d.includes((n.day+6)%7)&&e>1440&&n.min<e-1440)return {live:1,until:e-1440,x:w.x}}
let best=null;
for(let off=0;off<=7;off++){const dd=(n.day+off)%7;
for(const w of v.w){if(!w.d.includes(dd))continue;const f=tm(w.f),e=wEnd(w),s=off*1440+f;
if(off===0&&n.min>=f&&n.min<e)return {live:1,until:e%1440,x:w.x};
if(s>n.min&&(!best||s<best.s))best={s,off,f:w.f,x:w.x,day:dd}}}
return best;
}
const SVREF=(v)=>/club|music/i.test(v.ty)?200:220;
function hhSave(v,x){const ref=SVREF(v);let a=null;const m=/(\d+)\s*% off/.exec(x||'');
if(m)a=Math.round(ref*(+m[1])/100);else if(typeof v.p==='number'&&v.p<ref)a=ref-v.p;
return a&&a>0?a:null}
function rGo(){
const el=$('goList');if(!el)return;
document.querySelectorAll('.gotabs button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.g===GO));
const hm=m=>String(Math.floor(m/60)%24).padStart(2,'0')+':'+String(m%60).padStart(2,'0');
if(GO==='fd'){const f=fdRows();$('goHead').textContent=f.op.length?t('Open now')+' · '+f.op.length:t('Nothing in this list is open right now.');el.innerHTML=f.rows.map(fdCard).join('');$('goNote').textContent=t('Hours and prices come from listings and delivery apps, not from the venues. Check before you go.');return}
if(GO==='cl'){$('goHead').textContent='';el.innerHTML=clubCards();$('goNote').textContent=t("Check the club page for tonight's cover and hours before you go.")+' '+t('Ratings are Google Maps averages, checked 15 Nov 2026.');return}
const L=hh.filter(v=>!v.warn).map(v=>({v,s:hhState(v)})).filter(x=>x.s);
L.sort((a,b)=>(b.s.live?1:0)-(a.s.live?1:0)||(a.s.live?((a.v.p??999)-(b.v.p??999)):(a.s.s-b.s.s)));
const live=L.filter(x=>x.s.live).length;
$('goHead').textContent=live?t('On right now')+' · '+live:t('Nothing is running right now. These start next.');
const D=DAYSL[LANG];
el.innerHTML=L.slice(0,Math.max(live,8)).map(({v,s})=>{
const when=s.live?t('On now until {0}',hm(s.until)):t('Starts {0}',s.off===0?s.f:(s.off===1?t('Tomorrow')+' '+s.f:D[s.day]+' '+s.f));
return `<div class="gocard"><div class="gc-main"><b>${v.n}</b><small>${t(s.x)} · ${v.a}</small>${rtHtml(v.n)}${(()=>{const a=hhSave(v,s.x);return a?`<small class="gc-save" style="color:var(--good);font-weight:700">${t('Save ~{0} a drink',money(a))}</small>`:''})()}</div><span class="gc-pill${s.live?' live':''}">${when}</span><a class="gc-go" href="${gmUrl(v.n+', '+v.ad+', Praha')}" target="_blank" rel="noopener">${t('Go')}</a></div>`}).join('');
$('goNote').textContent=t('Tap Go to open the place in Google Maps.')+' '+t('Ratings are Google Maps averages, checked 15 Nov 2026.')+' '+t('Savings are estimates: the happy-hour price against {0} for a cocktail at a cocktail bar, or {1} at a club or music bar. Percent deals use the same figures.',money(220),money(200));
}
function rClubs(){
if($('clubGuide'))$('clubGuide').innerHTML=clubCards();
$('clubRange').innerHTML=rangeRows(clubs.map(c=>({...c,n:t(c.n),note:t(c.note)})),Math.ceil(Math.max(...clubs.map(c=>c.hi))/100)*100,100);
const c=clubs[S.club],yrC=c.mid*S.clubM*12;
$('o-cm').textContent=S.clubM;
$('clubOut').innerHTML=kv(t('Cover per visit'),c.lo===c.hi?money(c.lo):money(c.lo)+'–'+money(c.hi),t(c.note))+kv(t('Cover per year'),money(yrC),t('{0} a month at the midpoint',plural(S.clubM,'visit')))+kv(t('Share of a club night'),pct(c.mid/(c.mid+800)*100),t('cover against 4 cocktails at 200 Kč'))+kv(t('Per visit incl. drinks'),money(c.mid+800),t('cover plus 4 cocktails'));
}
function nightTotals(){return nights.map(n=>({...n,total:(n.food+n.drinks)*(1+S.tip/100)+n.cover}))}
function rNights(){
const nt=nightTotals(),mx=Math.max(...nt.map(n=>n.total));
$('o-tip').textContent=pct(S.tip);
$('nightStack').innerHTML=nt.map(n=>{
const k=1+S.tip/100,d=n.drinks*k,f=n.food*k,c=n.cover,sc=n.total/mx*100;
return `<div class="br"><div class="br-h"><span>${t(n.n)}<small>${t(n.desc)}</small></span><b>${money(n.total)}</b></div><div class="stackbar" style="width:${sc}%"><i class="sg-d" style="width:${d/n.total*100}%"></i><i class="sg-f" style="width:${f/n.total*100}%"></i><i class="sg-c" style="width:${c/n.total*100}%"></i></div></div>`}).join('');
$('nightTbl').innerHTML=`<tr><th>${t('Night')}</th><th>${t('Once a week')}</th><th>${t('Your {0}×',P.w)}</th></tr>`+nt.map(n=>`<tr><td>${t(n.n)}</td><td>${money(n.total*52)}</td><td>${money(n.total*P.w*52)}</td></tr>`).join('');
const rest=nt.find(n=>n.n==='Restaurant dinner'),club=nt.find(n=>n.n==='Nightclub');
$('rvc').innerHTML=`<b>${t('Restaurant against nightclub.')}</b> ${t('A modelled club night costs {0} more than a restaurant dinner with two drinks ({1} against {2}). Every drink is a 200 Kč cocktail, and the 200 Kč cover comes on top.',money(club.total-rest.total),money(club.total),money(rest.total))}`;
}
function rTour(){
const A=tAreas()[S.areaA],B=tAreas()[S.areaB],n=P.d*P.w*52,yA=n*A.mid,yB=n*B.mid;
$('tourOut').innerHTML=kv(A.n,money(yA),t('per year at {0} a beer',money(A.mid)))+kv(B.n,money(yB),t('per year at {0} a beer',money(B.mid)))+kv(t('Difference'),money(Math.abs(yA-yB)),yA===yB?t('same price'):t('{0} costs more',yA>yB?A.n:B.n))+kv(t('Price multiple'),fx(Math.max(A.mid,B.mid)/Math.min(A.mid,B.mid),1)+'×',t('dearer area against cheaper'));
const mx=Math.max(yA,yB,1);
$('tourBars').innerHTML=barRows([{n:A.n,v:yA,cls:yA>yB?'hot':'good'},{n:B.n,v:yB,cls:yB>yA?'hot':'good'}],{max:mx,fmt:v=>money(v)});
}
function rTrend(){
const el=$('trendChart');
lineChart(el,{label:t('Prague draught beer price per half litre from 2021 to 2024, with a 2026 crowd-sourced point'),x0:2020.6,x1:2026.4,y0:40,y1:80,xt:[2021,2022,2023,2024,2025,2026],yt:[40,50,60,70,80],yf:v=>money(v),
refs:[{y:67.5,label:t('Your data average {0}',money(67.5))}],ann:[{x:2024,label:t('VAT 10% to 21%')}],
series:[{c:'--amber',pts:trend,dots:true,vals:true,vf:v=>money(v)},{c:'--food',pts:[[2026,69]],dots:true,hollow:true,line:false,vals:true,vf:v=>money(v),end:t('Numbeo')}]});
const tot=trend[3][1]/trend[0][1]-1,cagr=Math.pow(trend[3][1]/trend[0][1],1/3)-1,diff=trend[3][1]-trend[0][1];
$('trendStats').innerHTML=kv(t('2021 to 2024'),'+'+pct(tot*100),t('{0} to {1}',money(trend[0][1]),money(trend[3][1])))+kv(t('Per year '),'+'+pct(cagr*100,1),t('compounded'))+kv(t('Extra per pint'),'+'+money(diff))+kv(t('Extra per year'),money(diff*P.d*P.w*52),t('beer only, at your pace'));
$('trendTbl').innerHTML=`<tr><th>${t('Year')}</th><th>${t('Price')}</th><th>${t('Change')}</th></tr>`+trend.map((x,i)=>`<tr><td>${x[0]}</td><td>${money(x[1])}</td><td>${i?'+'+pct((x[1]/trend[i-1][1]-1)*100,1):t('base')}</td></tr>`).join('');
}
function rScen(){
const you={n:t('You'),v:yr(),cls:'good',note:t('{0} × {1} × {2} a week',P.d,money(P.p),P.w)+(P.o?t(' + other'):'')};
const items=scen.map(s=>({n:t(s.n),v:s.yr,note:t('{0} × {1} × {2}',plural(s.d,'drink'),plural(s.w,'night'),money(s.p))}));
items.push(you);
const mx=Math.max(...items.map(i=>i.v),1);
$('scBars').innerHTML=barRows(items,{max:mx,fmt:v=>money(v)});
$('scStats').innerHTML=kv(t('{0} vs {1}',t('Frequent'),t('Regular')),fx(scen[3].yr/scen[2].yr,1)+'×',t('the yearly bill'))+kv(t('{0} vs {1}',t('Regular'),t('Occasional')),fx(scen[2].yr/scen[0].yr,1)+'×',t('the yearly bill'));
$('scTbl').innerHTML=`<tr><th>${t('Lifestyle')}</th><th>${t('Weekly')}</th><th>${t('Monthly')}</th><th>${t('Annual')}</th></tr>`+scen.map(s=>`<tr class="${s.n==='Regular'?'hl':''}"><td>${t(s.n)}</td><td>${money(s.wk)}</td><td>${money(s.mo)}</td><td>${money(s.yr)}</td></tr>`).join('');
}
function svState(){return {d:P.d,w:P.w,p:P.p,o:P.o,disc:0}}
const svYr=s=>Math.max(0,s.d*s.p+s.o-s.disc)*s.w*52;
function rSav(){
const base=svState(),b=svYr(base);
const items=svOpts.map(o=>({n:t(o.n),v:Math.max(0,b-svYr(o.f(base))),cls:S.sv[o.id]?'good':'mute'}));
let st=svState();svOpts.forEach(o=>{if(S.sv[o.id])st=o.f(st)});
const after=svYr(st),saved=Math.max(0,b-after);
$('svBars').innerHTML=barRows(items,{max:Math.max(1,...items.map(i=>i.v)),fmt:v=>money(v)});
$('svOut').innerHTML=kv(t('You would save'),money(saved),t('per year, ticked changes combined'))+kv(t('New yearly spend'),money(after),t('down from {0}',money(b)))+kv(t('Saved per month'),money(saved/12))+kv(t('Share of your tab'),b?pct(saved/b*100):pct(0));
}
function rProj(){
const N=S.pY,i=S.pI/100,rt=S.pR/100,a=[[0,0]],c=[[0,0]];let cum=0,fv=0;
for(let k=1;k<=N;k++){const sp=yr()*Math.pow(1+i,k-1);cum+=sp;fv=fv*(1+rt)+sp;a.push([k,cum]);c.push([k,fv]);}
$('o-pY').textContent=plural(N,'year');$('o-pI').textContent=pct(S.pI,1);$('o-pR').textContent=pct(S.pR,1);
const yt=niceTicks(Math.max(cum,fv,1),4),xt=[];for(let k=0;k<=N;k+=(N>6?2:1))xt.push(k);
lineChart($('projChart'),{label:t('Cumulative spending over {0} years against the same money invested',N),x0:0,x1:N,y0:0,y1:yt[yt.length-1],xt,yt,yf:v=>P.cur!=='CZK'?cmpC(v/curRate()):(v>=1000?nf(v/1000)+(KS[LANG]||'k'):nf(v)),
series:[{c:'--amber',pts:a,dots:false,end:t('Spent')},{c:'--good',pts:c,dots:false,end:t('Invested')}]});
$('projOut').innerHTML=kv(t('Spent in {0}',plural(N,'year')),money(cum),t('first year {0}',money(yr())))+kv(t('Same money invested'),money(fv),t('at {0} a year',pct(S.pR,1)))+kv(t('Growth on top'),money(Math.max(0,fv-cum)),t('what investing would add'))+kv(t('Year {0} bill',N),money(yr()*Math.pow(1+i,N-1)),t('at {0} inflation',pct(S.pI,1)));
}
function syncProfile(){
$('i-d').value=P.d;$('i-p').value=P.p;$('i-w').value=P.w;$('i-o').value=P.o;
$('o-d').textContent=P.d;$('o-p').textContent=money(P.p);$('o-w').textContent=P.w;
document.querySelectorAll('#presets .chip').forEach((b,i)=>{const s=scen[i];b.classList.toggle('on',s.d===P.d&&s.w===P.w&&s.p===P.p&&P.o===0)});
document.querySelectorAll('#drinkChips .chip').forEach((b,i)=>b.classList.toggle('on',drinks[i].avg===P.p));
}
const PLX="Each night, without a plan: {0} cocktails at a craft bar ({1} each), {2} at a club ({3} each) and {4} to get in. With a plan: the bar cocktails at happy hour (about {5} each, the average of {6} places), the same club cocktails, and a club that is free or cheap to enter (about {7}). Prices come from the venue data further down this page.",PLX0="Each night, without a plan: {0} cocktails at a craft bar ({1} each). With a plan: the same cocktails at happy hour (about {2} each, the average of {3} places). Prices come from the venue data further down this page.";
const PLS={n:4,nights:1,kind:'c',snack:0,club:1};const PLBX="Each night, without a plan: {0} half-litre beers at an Old Town bar ({1} each). With a plan: the same beer at happy hour (about {2} each). Prices come from the price data further down this page.";
const H24=[0,1,2,3,4,5,6].map(()=>[[0,1440]]);
const GRATE={"Déjávu Music Bar":[4.4,1329],"The Pitch":[4.8,627],"Hard Rock Cafe Praha":[4.5,24613],"Slivovitz Museum":[4.8,1713],"ALIBI Cocktail & Music Bar":[4.5,969],"Zone Cocktail & Music Bar":[4.2,790],"Nebe Celnice":[4.1,3371],"La Bodeguita Del Medio":[4.3,6016],"Aloha Bar":[4.4,1557],"Hangar":[4.2,1187],"Kavárna Velryba":[4.4,1095],"Station Anděl":[4.5,163],"OPSO Shisha Lounge Bar":[4.5,145],"Pivovar U Supa":[4.6,7313],"Zlatý Strom":[4.2,1542],"Kayak Beach Bar":[4.3,1323],"Vinohradský pivovar":[4.5,2326],"Anonymous Bar":[4.4,4230],"Café Louvre":[4.5,24490],"Můj Šálek Kávy":[4.7,4632],"Ananas Bananas":[4.2,419],"Hemingway Bar":[4.7,4859],"Vinograf":[4.5,1359],"Bokovka":[4.4,831],"Café Savoy":[4.2,8417],"Le Valmont":[4.8,1499],"Duplex":[4.8,56635],"M1 Lounge":[4.2,2639],"Moon Club":[4.6,4822],"OX Club":[4.3,1640],"Cross Club":[4.4,3708],"Lucerna Music Bar":[4.5,6954],"Karlovy Lázně":[4.5,24939],"Roxy":[4.2,5714],"Chapeau Rouge":[4.0,4191],"EPIC Prague":[4.5,9623],"Ankali":[4.1,1120],"Fuchs2":[4.1,920],"Storm Club":[3.8,722],"Bike Jesus":[4.5,759],"Jazz Dock":[4.7,4175],"Termix":[3.5,188]};
const rtHtml=n=>{const r=GRATE[n];return r?`<small class="rt"><span style="color:var(--accent);font-weight:700">★ ${r[0].toFixed(1)}</span> · ${t('{0} Google reviews',r[1].toLocaleString(LOC()))}</small>`:''};
const FOOD=[
{n:"McDonald's Wenceslas Square",rt:3.8,rc:7285,ad:'Václavské náměstí 59, Praha 1',ty:'Fast food',w:H24,h24:1,p:135,it:'6 McNuggets',nt:['Price from a delivery app. It may be higher in store.','Hours from a listing, not the venue.']},
{n:'Burger King I.P. Pavlova',rt:4.0,rc:2463,ad:'Jugoslávská 3, Praha 2',ty:'Fast food',w:H24,h24:1,p:149,it:'5 Tenders',nt:['Hours are delivery-app times, so check before you go.','Price from a delivery app. It may be higher in store.']},
{n:'Pizza Nonstop',rt:3.6,rc:393,ad:'Vinohradská 226, Praha 3',ty:'Pizza delivery',w:[[[1020,1650]],[[1020,1650]],[[1020,1650]],[[1020,1650]],[[1020,1650]],[[1020,1650]],[[1020,1650]]],p:237,it:'Margherita 32 cm',nt:['Delivery only. The hours are delivery times.']},
{n:'Sayf Kebab',rt:4.0,rc:3851,ad:'Na Můstku 1, Praha 1',ty:'Kebab',w:null,p:220,it:'Dürüm',nt:['Price from a delivery app. It may be higher in store.']},
{n:'Fior di Pizza',rt:4.8,rc:863,ad:'Ostrovní 34, Praha 1',ty:'Pizzeria',w:[[[960,1680]],[[960,1680]],[[960,1680]],[[960,1680]],[[960,1710]],[[960,1710]],[[960,1680]]],p:229,it:'Margherita 33 cm',nt:['Hours are delivery-app times, so check before you go.','Price from a delivery app. It may be higher in store.']},
{n:'Original Shawarma',rt:4.1,rc:1258,ad:'Vodičkova 15, Praha 1',ty:'Shawarma',w:[[[720,1620]],[[720,1620]],[[720,1620]],[[720,1680]],[[720,1680]],[[720,1740]],[[720,1620]]],p:230,it:'A meal',nt:['Listing hours are unclear, so check before you go.','Price from one customer review, not a menu.']},
{n:'Royal Kebab & Pizza',rt:4.2,rc:1643,ad:'Spálená 2, Praha 1',ty:'Kebab and pizza',w:H24,h24:1,p:[100,200],e:1,it:'A meal',nt:['Price is a guide estimate, not the venue menu.','Hours from a listing, not the venue.']},
{n:'Marjánka Canteen',rt:4.4,rc:1559,ad:'Na Bělidle 38, Praha 5',ty:'Czech canteen',w:H24,h24:1,p:[140,170],e:1,it:'A main',nt:['Price is a guide estimate, not the venue menu.','Hours from a listing, not the venue.']},
{n:'Roma Uno',rt:4.0,rc:2013,ad:'Jagellonská 16, Praha 3',ty:'Pizza and pub',w:H24,h24:1,p:null,nt:['Hours from a listing, not the venue.']},
{n:'U Sudu',rt:4.2,rc:3718,ad:'Vodičkova 10, Praha 1',ty:'Wine cellar bar',w:[[[540,1560]],[[540,1560]],[[540,1560]],[[540,1560]],[[540,1560]],[[600,1560]],[[660,1560]]],p:null,nt:['Kitchen closes at 02:00. The bar stays open until 04:00 or 05:00.']}
];
const fdMid=v=>Array.isArray(v.p)?(v.p[0]+v.p[1])/2:v.p;
const FOODP=FOOD.map(fdMid).filter(x=>x!=null).sort((a,b)=>a-b),SNACK_PLAN=Math.round(FOODP.length%2?FOODP[(FOODP.length-1)/2]:(FOODP[FOODP.length/2-1]+FOODP[FOODP.length/2])/2),SNACK_TRAP=250;
const FD={tab:'open'};
function foodState(v){if(!v.w)return{k:'unk'};const n=pragueNow(),d=n.day,m=n.min;
for(const [o,c] of (v.w[d]||[]))if(m>=o&&m<c)return{k:'open',until:c%1440};
for(const [o,c] of (v.w[(d+6)%7]||[]))if(c>1440&&m<c-1440)return{k:'open',until:c-1440};
for(let i=0;i<8;i++){const dd=(d+i)%7;for(const [o,c] of (v.w[dd]||[]).slice().sort((a,b)=>a[0]-b[0]))if(i>0||o>m)return{k:'closed',off:i,dd,f:o}}
return{k:'closed'}}
function fdCard({v,s}){
const hm=m=>String(Math.floor(m/60)%24).padStart(2,'0')+':'+String(m%60).padStart(2,'0');

const st=s.k==='open'?(v.h24?t('Open 24 hours'):t('Open until {0}',hm(s.until))):s.k==='closed'?t('Closed, opens {0}',(s.off===0?'':s.off===1?t('Tomorrow')+' ':DAYS[s.dd]+' ')+hm(s.f)):t('Hours not confirmed');
const pl=v.p==null?t('Price not found'):v.e?t('About {0}',rng(v.p[0],v.p[1])):money(v.p);
return `<div class="gocard"><div class="gc-main"><b>${v.n}</b><small><span style="color:${s.k==='open'?'var(--good)':'var(--muted)'};font-weight:600">${st}</span> · ${t(v.ty)}${v.it?' · '+v.it:''}</small>${v.rt?`<small class="rt"><span style="color:var(--accent);font-weight:700">★ ${v.rt.toFixed(1)}</span> · ${t('{0} Google reviews',v.rc.toLocaleString(LOC()))}</small>`:''}<small style="color:var(--dim);font-size:12px">${[v.ad].concat(v.nt.filter(x=>x!=='Hours from a listing, not the venue.').map(x=>t(x))).join(' · ')}</small></div><span class="gc-pill${s.k==='open'?' live':''}">${pl}</span><a class="gc-go" href="${gmUrl(v.n+', '+v.ad)}" target="_blank" rel="noopener">${t('Go')}</a></div>`}
function fdRows(){const L=FOOD.map(v=>({v,s:foodState(v)})),op=L.filter(x=>x.s.k==='open'),cl=L.filter(x=>x.s.k==='closed'),pr=x=>fdMid(x.v)==null?1e9:fdMid(x.v);return{op,rows:op.slice().sort((a,b)=>pr(a)-pr(b)).concat(cl.sort((a,b)=>(a.s.off-b.s.off)||(a.s.f-b.s.f)),L.filter(x=>x.s.k==='unk'))}}
function rFood(){const el=$('fdList');if(!el)return;
const hm=m=>String(Math.floor(m/60)%24).padStart(2,'0')+':'+String(m%60).padStart(2,'0');
const L=FOOD.map(v=>({v,s:foodState(v)})),op=L.filter(x=>x.s.k==='open'),cl=L.filter(x=>x.s.k==='closed');
const tabs=[['open','Open now',op.length],['closed','Closed',cl.length],['all','All',L.length]];
$('fdTabs').innerHTML=tabs.map(x=>`<button type="button" class="chip${x[0]===FD.tab?' on':''}" data-t="${x[0]}">${t(x[1])} (${x[2]})</button>`).join('');
const pr=x=>fdMid(x.v)==null?1e9:fdMid(x.v);
let rows=FD.tab==='open'?op.slice().sort((a,b)=>pr(a)-pr(b)):FD.tab==='closed'?cl.slice().sort((a,b)=>(a.s.off-b.s.off)||(a.s.f-b.s.f)):op.sort((a,b)=>pr(a)-pr(b)).concat(cl.sort((a,b)=>(a.s.off-b.s.off)||(a.s.f-b.s.f)),L.filter(x=>x.s.k==='unk'));
el.innerHTML=rows.length?rows.map(fdCard).join(''):`<p class="cap">${t('Nothing in this list is open right now.')}</p>`;
$('fdNote').textContent=t('Hours and prices come from listings and delivery apps, not from the venues. Check before you go.')+' '+t('Ratings are Google Maps averages, checked 15 Nov 2026.')}
function rPlan(){
if(!$('plN'))return;
const beer=PLS.kind==='b',n=PLS.n,k=PLS.nights,cb=cocktails.find(c=>c.n==='Craft cocktail bar'),dc=cocktails.find(c=>c.n==='Downtown club'),craft=Math.round((cb.lo+cb.hi)/2),clubC=Math.round((dc.lo+dc.hi)/2);
const cover=clubs.find(c=>c.n==='Typical Prague club').mid,cheapCover=clubs.find(c=>c.n==='Cross Club').mid;
const ps=hh.filter(v=>v.p!=null).map(v=>v.p),avg=Math.round(ps.reduce((a,b)=>a+b,0)/ps.length*10)/10;
const clubN=(!beer&&PLS.club)?Math.max(1,n-Math.ceil(n*0.6)):0,barN=n-clubN,sn=PLS.snack?1:0;
const bn=areas.find(x=>x.n==='Old Town streets').mid,bh=extras.find(x=>x.n==='Beer at happy hour, 0.5 l'),bhp=(bh.lo+bh.hi)/2;
const P0=beer?bn:craft,P1=beer?bhp:avg;
const a=barN*P0+clubN*clubC+(clubN?cover:0)+sn*SNACK_TRAP,b=barN*P1+clubN*clubC+(clubN?cheapCover:0)+sn*SNACK_PLAN,keep=a-b,pc=a?keep/a*100:0;
const unit=t(beer?'Beer':'Cocktails').toLowerCase();
$('plKind').innerHTML=[['c','🍸','Cocktails'],['b','🍺','Beer']].map(x=>`<button type="button" class="${x[0]===PLS.kind?'on':''}" data-q="${x[0]}">${x[1]} ${t(x[2])}</button>`).join('');
$('plLbl').textContent=t(beer?'Total beers tonight':'Total cocktails tonight');
$('plN').textContent=n;$('plUnit').textContent=unit;
$('plQ').innerHTML=[2,4,6,8].map(x=>`<button type="button" class="${x===n?'on':''}" data-n="${x}">${x} ${unit}</button>`).join('');
$('plClubRow').hidden=beer;$('plClub').setAttribute('aria-checked',PLS.club?'true':'false');
$('plClubS').textContent=t('{0} at happy hour bar + {1} at club',barN,clubN);
$('plSn').setAttribute('aria-checked',sn?'true':'false');$('plSnS').textContent=t('{0} at a street stand vs {1} at a 24-hour place',money(SNACK_TRAP),money(SNACK_PLAN));
$('plNights').innerHTML=[1,2,3].map(x=>`<button type="button" class="chip${x===k?' on':''}" data-k="${x}">${x}</button>`).join('');
$('plTot').textContent=n+' '+t(beer?'Beer':'Cocktails');$('plSub').textContent=beer?t('Bars'):t('{0} bar + {1} club',barN,clubN);
$('plP').textContent=t('{0} saved',pct(pc));$('plK').textContent=money(Math.round(keep));
$('plA').textContent=money(Math.round(a));$('plB').textContent=money(Math.round(b));
$('plAb').style.width='100%';$('plBb').style.width=(a?b/a*100:0)+'%';
const R=[[beer?'Beers':'Bar cocktails',t('{0} × {1} vs {2}',barN,money(P0),money(P1)),barN*P0,barN*P1]];
if(clubN){R.push(['Club cocktails',clubN+' × '+money(clubC),clubN*clubC,clubN*clubC]);R.push(['Club entry',t('Standard vs guestlist or free'),cover,cheapCover])}
if(sn)R.push(['Late-night snack',t('Street stand vs 24-hour place'),SNACK_TRAP,SNACK_PLAN]);
$('plTb').innerHTML=R.map(r=>`<tr><td>${t(r[0])}<small>${r[1]}</small></td><td>${money(Math.round(r[2]))}</td><td>${money(Math.round(r[3]))}</td></tr>`).join('')+`<tr class="tot"><td>${t('Total')}</td><td>${money(Math.round(a))}</td><td>${money(Math.round(b))}</td></tr>`;
$('plY').textContent=t('Go out {0} a week? Keep {1} a year.',plural(k,'night'),money(Math.round(keep*k*52)));
$('plE').textContent=(beer?t(PLBX,barN,money(P0),money(P1)):clubN?t(PLX,barN,money(craft),clubN,money(clubC),money(cover),money(avg),ps.length,money(cheapCover)):t(PLX0,barN,money(craft),money(avg),ps.length))+(sn?' '+t('Snack: {0} at a Wenceslas Square sausage stand, against {1} at a typical 24-hour place.',money(SNACK_TRAP),money(SNACK_PLAN)):'');
$('plT').textContent=t('Happy hour runs at set times, so have your first drinks before it ends.');
}
const sv=(k,v)=>{try{localStorage.setItem(k,v)}catch(e){}};
try{const c=localStorage.getItem('pnt-cur');if(c&&CURS[c])P.cur=c}catch(e){}
function fillCur(){const bt=$('curBtn');if(!bt)return;let dn=null;try{dn=new Intl.DisplayNames([LANG],{type:'currency'})}catch(e){}
bt.textContent=P.cur+' ▾';bt.title=t('Rates are approximate');bt.setAttribute('aria-label',t('Currency')+': '+P.cur);
$('curMenu').innerHTML=Object.keys(CURS).map(c=>{let n='';try{n=dn?dn.of(c):''}catch(e){}return `<li><button type="button" role="option" data-c="${c}" aria-selected="${c===P.cur}"><b>${c}</b><span>${n}</span></button></li>`}).join('')+`<li class="cur-n">${t('Rates are approximate')}</li>`}
function curOpen(o){$('curMenu').hidden=!o;$('curBtn').setAttribute('aria-expanded',o?'true':'false');if(o){const s=$('curMenu').querySelector('[aria-selected="true"]');if(s)s.scrollIntoView({block:'center'})}}
let VIEW='menu',SEC=null;document.documentElement.dataset.view='menu';
const ICO={'s-overview':'M4 20V10M10 20V4M16 20v-8M22 20H2','s-weekend':'M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z','s-prices':'M6 8h9v11H6zM15 10h2.5a1.5 1.5 0 0 1 0 4H15M8 8V6M12 8V6','s-areas':'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4','s-cocktails':'M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6','s-food':'M7 3v8M5 3v5a2 2 0 0 0 4 4V3M7 12v9M17 3c-2 2-3 4-3 7h3v11','s-happy':'M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z','s-clubs':'M3 9a2 2 0 0 0 0 6v3h18v-3a2 2 0 0 1 0-6V6H3zM13 6v12','s-nights':'M12 3l2.5 5.5 6 .7-4.5 4 1.3 6-5.3-2.9L6.7 19.2 8 13.2 3.5 9.2l6-.7z','s-tourist':'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20a6 6 0 0 1 12 0M17 11a2.5 2.5 0 1 0 0-5M21 20a5 5 0 0 0-4-4.9','s-trend':'M3 17l6-6 4 4 8-8M15 7h6v6','s-scenarios':'M4 7h10M18 7h2M4 17h2M10 17h10M14 5v4M8 15v4','s-savings':'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v10M9.5 9.5c0-1 1-1.7 2.5-1.7s2.5.7 2.5 1.7-1 1.5-2.5 1.8-2.5.8-2.5 1.8 1 1.7 2.5 1.7 2.5-.7 2.5-1.7','s-projection':'M3 20h18M5 16l5-5 3 3 6-7','s-sources':'M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM8 7h7'};
const MIDS=['s-overview'].concat(sections.map(s=>s[0]).filter(id=>id!=='s-go'&&id!=='s-overview'));
function secInfo(id){const s=document.getElementById(id);if(!s)return{t:'',d:''};const hd=s.querySelector('.sec-head');if(hd){const p=hd.querySelector('p:not(.eyebrow)');return{t:hd.querySelector('h2').textContent,d:p?p.textContent:''}}const e=s.querySelector('.eyebrow'),l=s.querySelector('.lead'),h1=s.querySelector('h1');return{t:h1?h1.textContent:'',d:l?l.textContent:(e?e.textContent:'')}}
function renderMenu(){const m=$('menu');if(!m)return;m.innerHTML=`<p class="eyebrow">${t('Menu')}</p><p class="m-sub">${t('{0} quick ways to read a night out in Prague.',MIDS.length)}</p><div class="m-grid">`+MIDS.map((id,i)=>{const x=secInfo(id);return `<button type="button" class="mcard" data-s="${id}"><span class="mi"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${ICO[id]||'M12 12h.01'}"/></svg></span><span class="mt"><small>${String(i+1).padStart(2,'0')}</small><b>${x.t}</b><span>${x.d}</span></span><span class="mch" aria-hidden="true">›</span></button>`}).join('')+`</div><button type="button" class="linkbtn" data-all="1">${t('Show everything on one page')}</button>`}
function updNav(){document.querySelectorAll('#nav a').forEach(a=>{const on=MODE==='full'&&((VIEW==='menu'&&a.dataset.menu)||(VIEW==='sec'&&a.getAttribute('href')==='#'+SEC));a.classList.toggle('on',!!on)})}
function updCrumb(){const i=MIDS.indexOf(SEC),n=MIDS[i+1];document.querySelectorAll('.cb-back span').forEach(x=>x.textContent=t('Back to menu'));document.querySelectorAll('.cb-next').forEach(b=>{b.hidden=!n;if(n){b.dataset.s=n;b.textContent=t('Next: {0}',secInfo(n).t)+' ›'}})}
function setView(v,id){VIEW=v;SEC=id||null;document.documentElement.dataset.view=v;document.querySelectorAll('.sec').forEach(s=>s.classList.toggle('cur',s.id===SEC));updNav();updCrumb();if(!(v==='all'&&id))window.scrollTo({top:0})}
function showSec(id){setView('sec',id)}
function showAll(id){setView('all',id);if(id){const s=document.getElementById(id);if(s)s.scrollIntoView()}}
function renderAll(){renderAll0();renderMenu();updCrumb();updNav()}
function renderAll0(){rFood();rPlan();syncProfile();rCoaster();rKpis();rFindings();rPrices();rAreas();rCock();rHappy();rClubs();rNights();rTour();rTrend();try{rScen()}catch(e){}try{rSav()}catch(e){}rProj()}
function csv(){
const sec=(h,rows)=>h+'\n'+rows.map(x=>x.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
const nt=nightTotals();
return [
sec('Drink,Average_Price_CZK,Low_CZK,High_CZK',drinks.map(d=>[d.n,d.avg,d.lo,d.hi])),
sec('Lifestyle,Drinks_Per_Night,Nights_Per_Week,Price_Per_Drink,Weekly_CZK,Monthly_CZK,Annual_CZK',scen.map(s=>[s.n,s.d,s.w,s.p,s.wk,s.mo,s.yr])),
sec('Area,Beer_Low_CZK,Beer_High_CZK,Midpoint_CZK',areas.map(a=>[a.n,a.lo,a.hi,a.mid])),
sec('Cocktail_Bar_Type,Low_CZK,High_CZK',cocktails.map(c=>[c.n,c.lo,c.hi])),
sec('Club,Entrance_Low_CZK,Entrance_High_CZK,Note',clubs.map(c=>[c.n,c.lo,c.hi,c.note])),
sec('Modelled_Night,Assumptions,Total_CZK',nt.map(n=>[n.n,n.desc,n.total])),
sec('Venue,Area,Address,Type,Confirmation,Days,From,To,Deal',hhRows()),
sec('Year,Prague_Draught_Beer_CZK',trend)
].join('\n\n');
}
function json(){
return JSON.stringify({exchange_rate_czk_per_eur:RATE,weeks_per_month:WPM,
drinks:drinks.map(d=>({drink:d.n,average_czk:d.avg,low_czk:d.lo,high_czk:d.hi})),
scenarios:scen.map(s=>({lifestyle:s.n,drinks_per_night:s.d,nights_per_week:s.w,price_per_drink:s.p,weekly_czk:s.wk,monthly_czk:s.mo,annual_czk:s.yr})),
beer_by_area:areas.map(a=>({area:a.n,low_czk:a.lo,high_czk:a.hi,midpoint_czk:a.mid})),
cocktails_by_bar_type:cocktails.map(c=>({type:c.n,low_czk:c.lo,high_czk:c.hi})),
club_entrance:clubs.map(c=>({venue:c.n,low_czk:c.lo,high_czk:c.hi,note:c.note})),
modelled_nights:nightTotals().map(n=>({night:n.n,assumptions:n.desc,total_czk:n.total})),
happy_hours:hhRows().map(a=>({venue:a[0],area:a[1],address:a[2],type:a[3],confirmation:a[4],days:a[5],from:a[6],to:a[7],deal:a[8]})),
prague_draught_beer_price_czk:trend.map(x=>({year:x[0],price_czk:x[1]}))},null,2);
}
async function copyOut(kind){
const txt=kind==='json'?json():csv(),out=$('exOut');
out.value=txt;out.hidden=false;
try{await navigator.clipboard.writeText(txt);$('exMsg').textContent=t('Copied the {0} to your clipboard.',kind.toUpperCase())}
catch(e){out.focus();out.select();$('exMsg').textContent=t('Select the text below and copy it.')}
}
const STATIC=[],STATIC_ATTR=[];
function collectStatic(){
const w=document.createTreeWalker(document.querySelector('.app'),NodeFilter.SHOW_TEXT);
let n;
while((n=w.nextNode())){
const raw=n.nodeValue,txt=raw.replace(/\s+/g,' ').trim();
if(!txt)continue;
const p=n.parentNode;
if(p.closest('script,style,ol.src')||txt==='Prague Night Tab')continue;
STATIC.push({n,en:txt,lead:raw.match(/^\s*/)[0],trail:raw.match(/\s*$/)[0]});
}
document.querySelectorAll('.app [aria-label]').forEach(el=>STATIC_ATTR.push({el,en:el.getAttribute('aria-label')}));
}
function fillSelects(){
const keep=[$('areaA').value||S.areaA,$('areaB').value||S.areaB,$('clubSel').value||S.club];
$('areaA').innerHTML=$('areaB').innerHTML=areas.map((a,i)=>`<option value="${i}">${t(a.n)}</option>`).join('');
$('areaA').value=S.areaA;$('areaB').value=S.areaB;
$('clubSel').innerHTML=clubs.map((c,i)=>`<option value="${i}">${t(c.n)}</option>`).join('');$('clubSel').value=S.club;
}
function buildChips(){
$('nav').innerHTML=(MODE==='full'?`<li><a href="#menu" data-menu="1">${t('Menu')}</a></li>`:'')+sections.filter(s=>MODE==='full'?s[0]!=='s-go':LITE.includes(s[0])).map(s=>`<li><a href="#${s[0]}">${t(s[1])}</a></li>`).join('');if(typeof updNav==='function')updNav();
$('presets').innerHTML=scen.map((s,i)=>`<button type="button" class="chip" data-i="${i}">${t(s.n)}</button>`).join('');
$('drinkChips').innerHTML=drinks.map((d,i)=>`<button type="button" class="chip" data-i="${i}">${t(d.n)}</button>`).join('');
$('hhDays').innerHTML=DAYS.map((d,i)=>`<button type="button" class="chip" data-i="${i}" aria-label="${DAYL[i]}">${d}</button>`).join('');
if($('svList'))$('svList').innerHTML=svOpts.map(o=>`<label><input type="checkbox" id="${o.id}" ${S.sv[o.id]?'checked':''}>${t(o.n)}</label>`).join('');
const cur=location.hash.slice(1);
document.querySelectorAll('#nav a').forEach(a=>a.classList.toggle('on',a.getAttribute('href')==='#'+(cur||'s-overview')));
}
function themeIcon(th){
return th==='dark'
?'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>'
:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>';
}
function currentTheme(){
const a=document.documentElement.getAttribute('data-theme');
if(a==='dark'||a==='light')return a;
try{return window.matchMedia('(prefers-color-scheme: light)').matches?'light':'dark'}catch(e){return 'dark'}
}
function setTheme(th,save){
document.documentElement.setAttribute('data-theme',th);
if(save){try{localStorage.setItem('pnt-theme',th)}catch(e){}}
const b=$('themeBtn');
b.innerHTML=themeIcon(th);
const label=t(th==='dark'?'Switch to light theme':'Switch to dark theme');
b.setAttribute('aria-label',label);b.title=label;
}
async function setLang(l,save){
if(l!=='en')await loadTR(l);
LANG=l;DAYS=DAYSL[l];DAYL=DAYLL[l];
document.documentElement.lang=l;
if(save){try{localStorage.setItem('pnt-lang',l)}catch(e){}}
STATIC.forEach(x=>{x.n.nodeValue=x.lead+tx(x.en)+x.trail});
STATIC_ATTR.forEach(x=>x.el.setAttribute('aria-label',tx(x.en)));
$('langSel').value=l;
$('langSel').setAttribute('aria-label',t('Language'));
buildChips();fillSelects();fillCur();if(window.__splitDraw)window.__splitDraw();
$('ver').textContent=t('Version {0} · updated {1}',VERSION,VDATE.toLocaleDateString(LOC(),{day:'numeric',month:'long',year:'numeric'}));
setTheme(currentTheme(),false);
renderAll();
}
(function init(){
collectStatic();
let lang='en';
$('langSel').innerHTML=Object.keys(NAMES).map(k=>`<option value="${k}" lang="${k}">${NAMES[k]}</option>`).join('');
try{const s=localStorage.getItem('pnt-lang');if(s&&NAMES[s])lang=s;else{let n=(navigator.language||'').toLowerCase().slice(0,2);if(n==='no'||n==='nn')n='nb';if(NAMES[n])lang=n}}catch(e){}
$('presets').addEventListener('click',e=>{const b=e.target.closest('.chip');if(!b)return;const s=scen[+b.dataset.i];P.d=s.d;P.w=s.w;P.p=s.p;P.o=0;renderAll()});
$('drinkChips').addEventListener('click',e=>{const b=e.target.closest('.chip');if(!b)return;P.p=drinks[+b.dataset.i].avg;renderAll()});
$('plMinus').addEventListener('click',()=>{PLS.n=Math.max(1,PLS.n-1);rPlan()});
$('plPlus').addEventListener('click',()=>{PLS.n=Math.min(12,PLS.n+1);rPlan()});
$('plQ').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;PLS.n=+b.dataset.n;rPlan()});
$('plClub').addEventListener('click',()=>{PLS.club=PLS.club?0:1;rPlan()});
$('plSn').addEventListener('click',()=>{PLS.snack=PLS.snack?0:1;rPlan()});
$('fdTabs').addEventListener('click',e=>{const b=e.target.closest('.chip');if(!b)return;FD.tab=b.dataset.t;rFood()});
$('plKind').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;PLS.kind=b.dataset.q;rPlan()});
$('plNights').addEventListener('click',e=>{const b=e.target.closest('.chip');if(!b)return;PLS.nights=+b.dataset.k;rPlan()});
(function(){let x0=0,y0=0,t0=0,ok=false,ig=false;
const hs=el=>{for(;el&&el!==document.body;el=el.parentElement){const o=getComputedStyle(el).overflowX;if((o==='auto'||o==='scroll')&&el.scrollWidth>el.clientWidth+2)return true}return false};
document.addEventListener('touchstart',e=>{const t=e.touches[0];x0=t.clientX;y0=t.clientY;t0=Date.now();ig=!!e.target.closest('#s-go');ok=e.touches.length===1&&!hs(e.target)&&!e.target.closest('input,select,textarea,#curMenu,svg')},{passive:true});
document.addEventListener('touchend',e=>{if(!ok)return;ok=false;const t=e.changedTouches[0],dx=t.clientX-x0,dy=t.clientY-y0;
if(Math.abs(dx)<60||Math.abs(dx)<Math.abs(dy)*1.5||Date.now()-t0>700)return;const nx=dx<0;
if(MODE==='full'&&VIEW==='sec'){const i=MIDS.indexOf(SEC),n=nx?MIDS[i+1]:MIDS[i-1];if(n)showSec(n);else if(!nx)setView('menu');return}
if(MODE!=='full'&&ig){const O=['hh','cl','fd'],i=O.indexOf(GO),n=O[i+(nx?1:-1)];if(n&&n!==GO&&document.getElementById('s-go')){GO=n;rGo()}}},{passive:true})})();
document.addEventListener('click',e=>{if(MODE!=='full')return;
const c=e.target.closest('.mcard');if(c){showSec(c.dataset.s);return}
if(e.target.closest('[data-all]')){showAll();return}
if(e.target.closest('.cb-back')){setView('menu');return}
const nx=e.target.closest('.cb-next');if(nx){showSec(nx.dataset.s);return}
const a=e.target.closest('a[href^="#"]');if(!a)return;const id=a.getAttribute('href').slice(1);
if(a.dataset.menu){e.preventDefault();setView('menu');return}
if(id.startsWith('s-')&&document.getElementById(id)){e.preventDefault();VIEW==='all'?showAll(id):showSec(id)}});
if(location.hash&&/^#s-/.test(location.hash)&&MODE==='full'&&document.querySelector(location.hash))showSec(location.hash.slice(1));
$('areaMap').addEventListener('click',e=>{const g=e.target.closest('[data-ai]');if(g){AM.sel=+g.dataset.ai;rAreas()}});
$('areaMap').addEventListener('keydown',e=>{if(e.key!=='Enter'&&e.key!==' ')return;const g=e.target.closest('[data-ai]');if(g){e.preventDefault();AM.sel=+g.dataset.ai;rAreas()}});
$('amTabs').addEventListener('click',e=>{const b=e.target.closest('button');if(b){AM.tab=b.dataset.am;rAreas()}});
$('amLive').addEventListener('click',e=>{const b=e.target.closest('[data-live]');if(b){AM.sel=+b.dataset.live;rAreas()}});
$('amDetail').addEventListener('click',e=>{const b=e.target.closest('[data-live]');if(b){AM.sel=+b.dataset.live;AM.tab='live';rAreas()}});
$('curBtn').addEventListener('click',e=>{e.stopPropagation();curOpen($('curMenu').hidden)});
$('curMenu').addEventListener('click',e=>{const b=e.target.closest('button[data-c]');if(!b)return;P.cur=b.dataset.c;sv('pnt-cur',P.cur);curOpen(false);renderAll();fillCur()});
document.addEventListener('click',e=>{if(!e.target.closest('.cur'))curOpen(false)});document.addEventListener('keydown',e=>{if(e.key==='Escape')curOpen(false)});
(async()=>{try{const c=new AbortController();setTimeout(()=>c.abort(),6000);const r=await fetch('https://open.er-api.com/v6/latest/CZK',{signal:c.signal});const j=await r.json();if(j&&j.rates){let ch=0;for(const k in CURS){if(k!=='CZK'&&j.rates[k]>0){CURS[k]=1/j.rates[k];ch=1}}if(ch)renderAll()}}catch(e){}})();
$('i-d').addEventListener('input',e=>{P.d=+e.target.value;renderAll()});
$('i-p').addEventListener('input',e=>{P.p=+e.target.value;renderAll()});
$('i-w').addEventListener('input',e=>{P.w=+e.target.value;renderAll()});
$('i-o').addEventListener('input',e=>{P.o=Math.max(0,+e.target.value||0);renderAll()});
$('hhT').addEventListener('change',e=>{S.hhT=e.target.value;rCock()});
$('hhN').addEventListener('input',e=>{S.hhN=+e.target.value;rCock()});
HH.day=pragueNow().day;
$('hhDays').addEventListener('click',e=>{const b=e.target.closest('.chip');if(!b)return;HH.day=+b.dataset.i;HH.open=false;$('hhNow').checked=false;rHappy()});
$('hhNow').addEventListener('change',e=>{HH.open=e.target.checked;if(HH.open)HH.day=pragueNow().day;rHappy()});
$('hhConf').addEventListener('change',e=>{HH.conf=e.target.checked;rHappy()});
$('clubSel').addEventListener('change',e=>{S.club=+e.target.value;rClubs()});
$('clubM').addEventListener('input',e=>{S.clubM=+e.target.value;rClubs()});
$('tip').addEventListener('input',e=>{S.tip=+e.target.value;rNights()});
$('areaA').addEventListener('change',e=>{S.areaA=+e.target.value;rTour()});
$('areaB').addEventListener('change',e=>{S.areaB=+e.target.value;rTour()});
($('svList')||document.createElement('i')).addEventListener('change',e=>{const id=e.target.id;if(id in S.sv){S.sv[id]=e.target.checked;rSav()}});
$('pY').addEventListener('input',e=>{S.pY=+e.target.value;rProj()});
$('pI').addEventListener('input',e=>{S.pI=+e.target.value;rProj()});
$('pR').addEventListener('input',e=>{S.pR=+e.target.value;rProj()});
document.querySelectorAll('.gotabs button').forEach(b=>b.addEventListener('click',()=>{GO=b.dataset.g;rGo()}));
document.querySelectorAll('.modes button').forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.m,true)));
document.querySelectorAll('.modes button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.m===MODE));
$('langSel').addEventListener('change',e=>setLang(e.target.value,true));
$('themeBtn').addEventListener('click',()=>setTheme(currentTheme()==='dark'?'light':'dark',true));
(function(){const b=document.getElementById('instBtn');if(!b)return;let dp=null;
const standalone=matchMedia('(display-mode: standalone)').matches||navigator.standalone;
if(standalone)b.hidden=true;
const ua=navigator.userAgent;
const ios=/iPad|iPhone|iPod/.test(ua)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);
const inApp=/FBAN|FBAV|Instagram|Line\/|Snapchat|TikTok|Messenger|MicroMessenger|GSA\//.test(ua)||(ios&&!/Safari/.test(ua)&&!/CriOS|FxiOS|EdgiOS/.test(ua));
addEventListener('beforeinstallprompt',e=>{e.preventDefault();dp=e});
addEventListener('appinstalled',()=>{b.hidden=true;closeS()});
let sheet=null,plat=ios?'ios':'and';
const SH='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M8 7l4-4 4 4M6 11H5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1h-1"/></svg>';
const DOTS='<b aria-hidden="true">⋮</b>';
function closeS(){if(sheet)sheet.hidden=true}
function draw(){
const steps=plat==='ios'?[t('Tap the Share button {0} at the bottom of Safari.',SH),t('Scroll down and tap Add to Home Screen.'),t('Tap Add. Night Tab now sits on your home screen like an app.')]:[t('Tap the menu {0} at the top right of Chrome.',DOTS),t('Tap Install app, or Add to Home screen.'),t('Tap Install. Night Tab now sits on your home screen like an app.')];
const warn=[];
if(inApp)warn.push(t('You are inside another app. Tap Copy link, then open it in Safari (iPhone) or Chrome (Android).'));
else if(plat==='ios'&&!ios)warn.push(t('These steps are for iPhone. Open this page in Safari on the phone.'));
if(location.protocol==='file:')warn.push(t('Installing only works from the web link of the hosted app, not from a downloaded file.'));
sheet.querySelector('.box').innerHTML='<h3>'+t('Install on your phone')+'</h3><p class="sub">'+t('Free, no app store. Works offline once installed.')+'</p>'
+'<div class="tabs"><button type="button" data-p="ios" aria-pressed="'+(plat==='ios')+'">iPhone</button><button type="button" data-p="and" aria-pressed="'+(plat==='and')+'">Android</button></div>'
+'<ol>'+steps.map((s,i)=>'<li><i>'+(i+1)+'</i><span>'+s+'</span></li>').join('')+'</ol>'
+warn.map(w=>'<p class="warn">'+w+'</p>').join('')
+'<div class="row">'+(plat==='and'&&dp?'<button type="button" class="pri" data-a="go">'+t('Install now')+'</button>':'')+'<button type="button" data-a="copy">'+t('Copy link')+'</button><button type="button" data-a="x">'+t('Close')+'</button></div>';
}
function openS(){
if(!sheet){sheet=document.createElement('div');sheet.id='instSheet';sheet.hidden=true;sheet.innerHTML='<div class="box" role="dialog" aria-modal="true"></div>';document.body.appendChild(sheet);
sheet.addEventListener('click',async e=>{
if(e.target===sheet){closeS();return}
const p=e.target.closest('[data-p]'),a=e.target.closest('[data-a]');
if(p){plat=p.dataset.p;draw();return}
if(!a)return;
if(a.dataset.a==='x')closeS();
else if(a.dataset.a==='go'&&dp){dp.prompt();try{await dp.userChoice}catch(_){}dp=null;closeS()}
else if(a.dataset.a==='copy'){const u=location.href.split('#')[0];let ok=false;try{await navigator.clipboard.writeText(u);ok=true}catch(_){}
if(!ok){const ta=document.createElement('textarea');ta.value=u;document.body.appendChild(ta);ta.select();try{ok=document.execCommand('copy')}catch(_){}ta.remove()}
a.textContent=ok?t('Link copied'):u;setTimeout(()=>{if(!sheet.hidden)draw()},2500)}});
addEventListener('keydown',e=>{if(e.key==='Escape')closeS()})}
draw();sheet.hidden=false}
b.addEventListener('click',async()=>{
if(dp&&!ios){dp.prompt();try{await dp.userChoice}catch(e){}dp=null;return}
openS()});
if('serviceWorker' in navigator&&location.protocol.startsWith('http'))navigator.serviceWorker.register('sw.js').catch(()=>{});
})();
setLang(lang,false);
setInterval(()=>{if(!document.hidden){rHappy();rFood()}},60000);
let tid;window.addEventListener('resize',()=>{clearTimeout(tid);tid=setTimeout(()=>{rTrend();rProj()},120)});
try{
const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting&&(MODE==='lite'||VIEW==='all')){document.querySelectorAll('#nav a').forEach(a=>a.classList.toggle('on',a.getAttribute('href')==='#'+e.target.id))}})},{rootMargin:'-30% 0px -65% 0px'});
document.querySelectorAll('.sec').forEach(s=>io.observe(s));
}catch(e){}

(function(){
const GR=[['tonight','Tonight',['s-go','s-happy'],'🌙'],
['plan','Plan',['s-weekend','s-nights'],'<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><rect x="3.5" y="1.5" width="17" height="21" rx="3.2" fill="#4b5563"/><rect x="6" y="4" width="12" height="5" rx="1.3" fill="#86efac"/><g fill="#e5e7eb"><circle cx="8" cy="12.2" r="1.3"/><circle cx="12" cy="12.2" r="1.3"/><circle cx="16" cy="12.2" r="1.3"/><circle cx="8" cy="15.6" r="1.3"/><circle cx="12" cy="15.6" r="1.3"/><circle cx="16" cy="15.6" r="1.3"/></g><circle cx="8" cy="19" r="1.3" fill="#e5e7eb"/><circle cx="12" cy="19" r="1.3" fill="#e5e7eb"/><rect x="14.5" y="17.7" width="3" height="2.6" rx="1.3" fill="#fb923c"/></svg>'],
['prices','Prices',['s-overview','s-prices','s-cocktails','s-trend'],'🍺'],
['areas','Areas',['s-areas'],'🗺️'],
['sources','Sources',['s-sources'],'ℹ️']];
const LAB={'s-go':'Right now'};sections.forEach(s=>{LAB[s[0]]=LAB[s[0]]||s[1]});
const FLAT=GR.flatMap(g=>g[2]);let CS=null;
document.documentElement.setAttribute('data-split','1');
if(MODE!=='full')setMode('full');
const rail=document.querySelector('.rail');
const sub=document.createElement('div');sub.id='subnav';sub.setAttribute('role','group');rail.appendChild(sub);
const dock=document.createElement('nav');dock.id='dock';dock.setAttribute('aria-label','Main');dock.innerHTML='<div></div>';document.body.appendChild(dock);
function cnt(){const B=document.querySelectorAll('.gotabs button');if(!B.length)return;
 const fo=FOOD.filter(v=>foodState(v).k==='open').length;
 const v={hh:t('{0} bars',hh.length+hhInc.length),cl:t('{0} places',clubGuide.length),fd:t('{0} open',fo)};
 B.forEach(b=>{const k=b.dataset.g;let sm=b.querySelector('small');if(!sm){sm=document.createElement('small');b.appendChild(sm)}sm.textContent=v[k]})}
setInterval(cnt,60000);

(function(){const ib=document.getElementById('instBtn'),ss=document.querySelector('#s-sources .sec-head');if(!ib||!ss)return;
 const c=ib.cloneNode(true);c.id='instBtn2';c.style.marginTop='14px';c.addEventListener('click',()=>{go('s-go');setTimeout(()=>ib.click(),50)});ss.appendChild(c);
 new MutationObserver(()=>{c.hidden=ib.hidden}).observe(ib,{attributes:true,attributeFilter:['hidden']});c.hidden=ib.hidden})();
function gi(id){return GR.findIndex(g=>g[2].includes(id))}
function draw(){const g=GR[gi(CS)];cnt();
 dock.firstChild.innerHTML=GR.map(x=>`<button type="button" data-g="${x[0]}" ${x===g?'aria-current="page"':''}><span class="ic" aria-hidden="true">${x[3]}</span><span>${t(x[1])}</span></button>`).join('');
 sub.hidden=g[2].length<2;sub.setAttribute('aria-label',t(g[1]));
 sub.innerHTML=g[2].map(id=>`<button type="button" data-s="${id}" ${id===CS?'aria-current="true"':''}>${t(LAB[id])}</button>`).join('');
 const a=sub.querySelector('[aria-current]');if(a&&a.scrollIntoView)try{a.scrollIntoView({inline:'center',block:'nearest'})}catch(e){}}
function go(id,keep){if(!document.getElementById(id))return;CS=id;document.querySelectorAll('.sec').forEach(s=>s.classList.toggle('cur',s.id===id));draw();if(!keep)window.scrollTo({top:0});try{localStorage.setItem('pnt-sec',id)}catch(e){}}
dock.addEventListener('click',e=>{const b=e.target.closest('button[data-g]');if(b)go(GR.find(x=>x[0]===b.dataset.g)[2][0])});
sub.addEventListener('click',e=>{const b=e.target.closest('button[data-s]');if(b)go(b.dataset.s)});
let x0=0,y0=0,t0=0,ok=false;
const hs=el=>{for(;el&&el!==document.body;el=el.parentElement){const o=getComputedStyle(el).overflowX;if((o==='auto'||o==='scroll')&&el.scrollWidth>el.clientWidth+2)return true}return false};
document.addEventListener('touchstart',e=>{const q=e.touches[0];x0=q.clientX;y0=q.clientY;t0=Date.now();ok=e.touches.length===1&&!hs(e.target)&&!e.target.closest('input,select,textarea,#curMenu,svg,#dock')},{passive:true});
document.addEventListener('touchend',e=>{if(!ok)return;ok=false;const q=e.changedTouches[0],dx=q.clientX-x0,dy=q.clientY-y0;if(Math.abs(dx)<60||Math.abs(dx)<Math.abs(dy)*1.5||Date.now()-t0>700)return;const i=FLAT.indexOf(CS),n=FLAT[i+(dx<0?1:-1)];if(n)go(n)},{passive:true});

const ZS=[.85,1,1.15,1.3,1.5];let zi=0;try{const z=+localStorage.getItem('pnt-zoom2');if(ZS.includes(z))zi=ZS.indexOf(z)}catch(e){}
const zm=document.createElement('div');zm.id='zm';zm.className='shut';document.body.appendChild(zm);
function zapply(){document.documentElement.style.zoom=ZS[zi]===1?'':ZS[zi];try{localStorage.setItem('pnt-zoom2',ZS[zi])}catch(e){}
 zm.innerHTML=`<button type="button" class="zo" data-z="o" aria-label="Page size" aria-expanded="${!zm.classList.contains('shut')}">Aa</button><span class="zc" style="display:contents"><button type="button" data-z="-" aria-label="Zoom out" ${zi===0?'disabled':''}>−</button><button type="button" class="zv" data-z="0" aria-label="Reset zoom">${Math.round(ZS[zi]*100)}%</button><button type="button" data-z="+" aria-label="Zoom in" ${zi===ZS.length-1?'disabled':''}>+</button></span>`}
zm.addEventListener('click',e=>{const b=e.target.closest('button');if(!b||b.disabled)return;const k=b.dataset.z;if(k==='o')zm.classList.toggle('shut');else if(k==='-')zi=Math.max(0,zi-1);else if(k==='+')zi=Math.min(ZS.length-1,zi+1);else zi=0;zapply()});
zapply();
const _lang=window.applyLang;
document.addEventListener('pnt-lang',draw);
window.__splitDraw=draw;
let st=null;try{st=localStorage.getItem('pnt-sec')}catch(e){}
const hid=(location.hash||'').slice(1);
go(FLAT.includes(hid)?hid:(FLAT.includes(st)?st:'s-go'),true);
})();
})();
</script>

<noscript><p style="padding:24px;font-family:sans-serif">Prague Night Tab needs JavaScript to show its charts and tables.</p></noscript>
