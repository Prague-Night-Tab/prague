<script>
const RATE=25,WPM=4.33,VERSION='2.2',VDATE=new Date(2026,10,12);
const $=id=>document.getElementById(id)||document.createElement('div');
let LANG='en';
const LOCS={en:'en-US',cs:'cs-CZ',pt:'pt-PT',it:'it-IT',fr:'fr-FR',es:'es-ES',ru:'ru-RU',de:'de-DE',ja:'ja-JP',zh:'zh-CN',pl:'pl-PL',hu:'hu-HU',sv:'sv-SE',nb:'nb-NO',da:'da-DK',ro:'ro-RO',uk:'uk-UA',tr:'tr-TR',ko:'ko-KR',hi:'hi-IN',el:'el-GR'};
const LOC=()=>LOCS[LANG];
const NAMES={en:'English',cs:'Čeština',pt:'Português',it:'Italiano',fr:'Français',es:'Español',ru:'Русский',de:'Deutsch',ja:'日本語',zh:'中文',pl:'Polski',hu:'Magyar',sv:'Svenska',nb:'Norsk',da:'Dansk',ro:'Română',uk:'Українська',tr:'Türkçe',ko:'한국어',hi:'हिन्दी',el:'Ελληνικά'};
const PCTSP=['cs','de','fr','es','ru'],EURSUF=['cs','de','fr','es','it','ru','pt'];
const KS={cs:' tis.',ru:' тыс.',de:' Tsd.'};
const hasT=(l,k)=>l!=='en'&&TR[l]&&Object.prototype.hasOwnProperty.call(TR[l],k);
const tx=k=>hasT(LANG,k)?TR[LANG][k]:k;
const MISS=new Set();
const t=(k,...a)=>{
let s=k;
if(LANG!=='en'){if(hasT(LANG,k))s=TR[LANG][k];else MISS.add(k)}
return a.length?s.replace(/\{(\d+)\}/g,(m,i)=>a[+i]):s;
};
const nf=n=>Math.round(n).toLocaleString(LOC());
const fx=(n,d)=>n.toLocaleString(LOC(),{minimumFractionDigits:d,maximumFractionDigits:d});
const pct=(v,d)=>fx(v,d||0)+(PCTSP.includes(LANG)?'\u00a0%':'%');
const PL={
en:{drink:['drink','drinks'],night:['night','nights'],year:['year','years'],visit:['visit','visits'],place:['place','places']},
cs:{drink:['nápoj','nápoje','nápojů'],night:['večer','večery','večerů'],year:['rok','roky','let'],visit:['návštěva','návštěvy','návštěv'],place:['podnik','podniky','podniků']},
pt:{drink:['bebida','bebidas'],night:['noite','noites'],year:['ano','anos'],visit:['visita','visitas'],place:['local','locais']},
it:{drink:['drink','drink'],night:['serata','serate'],year:['anno','anni'],visit:['visita','visite'],place:['locale','locali']},
fr:{drink:['verre','verres'],night:['soirée','soirées'],year:['an','ans'],visit:['visite','visites'],place:['lieu','lieux']},
es:{drink:['copa','copas'],night:['noche','noches'],year:['año','años'],visit:['visita','visitas'],place:['local','locales']},
ru:{drink:['напиток','напитка','напитков'],night:['вечер','вечера','вечеров'],year:['год','года','лет'],visit:['визит','визита','визитов'],place:['заведение','заведения','заведений']},
de:{drink:['Drink','Drinks'],night:['Abend','Abende'],year:['Jahr','Jahre'],visit:['Besuch','Besuche'],place:['Lokal','Lokale']},
ja:{drink:['杯'],night:['晩'],year:['年'],visit:['回'],place:['軒']},
zh:{drink:['杯'],night:['晚'],year:['年'],visit:['次'],place:['家']},
pl:{drink:['drink','drinki','drinków'],night:['wieczór','wieczory','wieczorów'],year:['rok','lata','lat'],visit:['wizyta','wizyty','wizyt'],place:['miejsce','miejsca','miejsc']},
hu:{drink:['ital','ital'],night:['este','este'],year:['év','év'],visit:['látogatás','látogatás'],place:['hely','hely']},
sv:{drink:['drink','drinkar'],night:['kväll','kvällar'],year:['år','år'],visit:['besök','besök'],place:['ställe','ställen']},
nb:{drink:['drink','drinker'],night:['kveld','kvelder'],year:['år','år'],visit:['besøk','besøk'],place:['sted','steder']},
da:{drink:['drink','drinks'],night:['aften','aftener'],year:['år','år'],visit:['besøg','besøg'],place:['sted','steder']},
ro:{drink:['băutură','băuturi','de băuturi'],night:['seară','seri','de seri'],year:['an','ani','de ani'],visit:['vizită','vizite','de vizite'],place:['loc','locuri','de locuri']},
uk:{drink:['напій','напої','напоїв'],night:['вечір','вечори','вечорів'],year:['рік','роки','років'],visit:['візит','візити','візитів'],place:['заклад','заклади','закладів']},
tr:{drink:['içecek','içecek'],night:['akşam','akşam'],year:['yıl','yıl'],visit:['ziyaret','ziyaret'],place:['mekân','mekân']},
ko:{drink:['잔'],night:['밤'],year:['년'],visit:['회'],place:['곳']},
hi:{drink:['ड्रिंक','ड्रिंक'],night:['शाम','शामें'],year:['साल','साल'],visit:['बार','बार'],place:['जगह','जगहें']},
 el:{drink:['ποτό','ποτά'],night:['βράδυ','βράδια'],year:['έτος','έτη'],visit:['επίσκεψη','επισκέψεις'],place:['μέρος','μέρη']}
};
function plural(n,w){
const f=PL[LANG][w];
if(LANG==='ja'||LANG==='zh'||LANG==='ko')return n+f[0];
let i;
if(LANG==='cs')i=n===1?0:(n>=2&&n<=4?1:2);
else if(LANG==='pl'){const a=n%10,b=n%100;i=n===1?0:((a>=2&&a<=4&&(b<12||b>14))?1:2)}
else if(LANG==='ro'){const b=n%100;i=n===1?0:((n===0||(b>=1&&b<=19))?1:2)}
else if(LANG==='ru'||LANG==='uk'){const a=n%10,b=n%100;i=(a===1&&b!==11)?0:((a>=2&&a<=4&&(b<12||b>14))?1:2)}
else if(LANG==='fr')i=n<2?0:1;
else i=n===1?0:1;
return n+' '+f[i];
}
const P={d:4,p:120,w:2,o:0,cur:'CZK'};
const S={tip:0,areaA:0,areaB:6,club:2,clubM:2,hhT:'beer',hhN:2,sv:{sv1:true,sv2:false,sv3:false,sv4:false,sv5:false},pY:10,pI:2.2,pR:4};
const CURS={CZK:1,EUR:25,USD:21.6,GBP:28.8,PLN:5.9,CHF:26.9,HUF:.0625,SEK:2.2,NOK:2.1,DKK:3.35,RON:5,UAH:.52,TRY:.5,JPY:.14,CNY:3,KRW:.0155,INR:.25,AUD:14,CAD:15.4,BRL:3.9,MXN:1.17};
const curRate=()=>CURS[P.cur]||1,ZERO=['JPY','KRW','HUF'];
function money(n){
if(P.cur!=='CZK'){const v=n/curRate(),d=(v<10&&!Number.isInteger(v)&&!ZERO.includes(P.cur))?2:0;try{return new Intl.NumberFormat(LOC(),{style:'currency',currency:P.cur,minimumFractionDigits:0,maximumFractionDigits:d}).format(v)}catch(e){return nf(v)+'\u00a0'+P.cur}}
return (Number.isInteger(n)||Math.abs(n)>=200?nf(n):n.toLocaleString(LOC(),{maximumFractionDigits:1}))+'\u00a0Kč';
}
const rng=(a,b)=>P.cur!=='CZK'?money(a)+'–'+money(b):nf(a)+'–'+nf(b)+'\u00a0Kč';
const cmpC=v=>{try{return new Intl.NumberFormat(LOC(),{style:'currency',currency:P.cur,notation:'compact',maximumFractionDigits:1}).format(v)}catch(e){return nf(v)}};
const eur=n=>EURSUF.includes(LANG)?nf(n/RATE)+'\u00a0€':'€'+nf(n/RATE);
const night=()=>P.d*P.p+P.o, wk=()=>night()*P.w, yr=()=>wk()*52, mo=()=>wk()*WPM;
const drinks=[
{n:'Beer',avg:67.5,lo:45,hi:90},
{n:'Wine',avg:112.5,lo:75,hi:150},
{n:'Aperol Spritz',avg:157.5,lo:120,hi:195},
{n:'Premium cocktail',avg:250,lo:180,hi:300}];
const scen=[
{n:'Occasional',d:2,w:1,p:100},
{n:'Social',d:3,w:1,p:120},
{n:'Regular',d:4,w:2,p:120},
{n:'Frequent',d:5,w:3,p:150}].map(s=>{s.wk=s.d*s.w*s.p;s.mo=+(s.wk*WPM).toFixed(1);s.yr=s.wk*52;return s});
const areas=[
{n:'Žižkov',lo:40,hi:60,note:'Densest pub scene in the city'},
{n:'Vršovice and Nusle',lo:40,hi:55,note:'Neighbourhood hospody'},
{n:'Holešovice and Karlín',lo:55,hi:70,note:'Local and expat mix'},
{n:'Smíchov',lo:45,hi:60,note:'Local pubs around Anděl and the Staropramen brewery'},
{n:'Vinohrady',lo:55,hi:80,note:'Gastropubs and wine bars'},
{n:'Old Town streets',lo:70,hi:120,note:'Tourist-oriented bars'},
{n:'Old Town Square terraces',lo:120,hi:160,note:'Paying for the address'}
].map(a=>{a.mid=(a.lo+a.hi)/2;return a});
const regions=[{n:'Prague',v:62.9,cls:''},{n:'Plzeň Region',v:53.5,cls:'food'},{n:'Moravian-Silesian Region',v:46.4,cls:'mute'}];
const cocktails=[
{n:'Happy hour, before 7 pm',lo:120,hi:150},
{n:'Downtown club',lo:198,hi:201},
{n:'Craft cocktail bar',lo:220,hi:300,note:'Dlouhá and Old Town cellars'},
{n:'Hotel or world-ranked bar',lo:240,hi:310,note:'Alcron, Hemingway and similar'}];
const namedBars=[
{n:'Náplavka riverfront bars',lo:120,hi:180},
{n:'U Sudu',lo:160,hi:200},
{n:'FRAME',lo:180,hi:260,note:'Gin and tonics'},
{n:'Hemingway Bar',lo:220,hi:260},
{n:'The Alchemist',lo:220,hi:280},
{n:'Bonvivant\'s',lo:220,hi:280},
{n:'AnonymouS Bar',lo:230,hi:230},
{n:'Alcron Bar',lo:240,hi:310},
{n:'Alma',lo:240,hi:320},
{n:'Anonymous Shrink\'s Office',lo:240,hi:290},
{n:'Terasa U Prince',lo:240,hi:340},
{n:'Café Bar Pilotů',lo:250,hi:310},
{n:'L\'Fleur',lo:260,hi:320,note:'Smoked drinks'},
{n:'Black Angel\'s',lo:280,hi:350},
{n:'BUGSY\'S',lo:280,hi:350}];
const extras=[
{n:'Wine, 1 dl glass at a wine bar',k:'from',lo:55},
{n:'Wine, glass at happy hour',k:'from',lo:60},
{n:'Wine, house glass in a restaurant',k:'range',lo:65,hi:135},
{n:'Wine, bottle of decent red',k:'about',lo:235},
{n:'Craft beer pour',k:'range',lo:70,hi:120},
{n:'Beer at happy hour, 0.5 l',k:'range',lo:35,hi:45},
{n:'Couvert or bread charge in traditional pubs',k:'about',lo:45}];
const clubs=[
{n:'Cross Club',lo:0,hi:100,note:'Usually free, small charge for live acts'},
{n:'Lucerna Music Bar',lo:100,hi:100,note:'80s and 90s party nights. Concerts cost more'},
{n:'Karlovy Lázně',lo:100,hi:300,note:'Five floors near Charles Bridge. One guide quotes 100 to 200 Kč, another 300 Kč at weekends'},
{n:'Duplex',lo:250,hi:400,note:'Wenceslas Square. 250 to 400 Kč depending on the night'},
{n:'Roxy',lo:100,hi:400,note:'Free Monday. Guides quote 100 to 150 Kč and 200 to 400 Kč on Saturdays'},
{n:'Chapeau Rouge',lo:0,hi:200,note:'Free before 23:00, then 100 to 200 Kč'},
{n:'EPIC Prague',lo:200,hi:400,note:'Before and after midnight. Headliner nights cost more'},
{n:'Ankali',lo:150,hi:500,note:'Techno. Depends on the line-up'},
{n:'Fuchs2',lo:400,hi:400,note:'Hardcore industrial techno in Karlín'},
{n:'Storm Club',lo:100,hi:150,note:'Drum and bass in Žižkov'},
{n:'Bike Jesus',lo:250,hi:250,note:'Cellar venue in Žižkov'},
